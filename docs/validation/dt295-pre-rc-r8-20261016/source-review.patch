+    assert(stops == 2 && cancels == 2 && shutdowns == 1 && closed == 1);
+    assert(live_add_event_count == 0 && live_add_summary_count == 0);
+    reset();
+    fixture_mode = FIXTURE_WRITE_FAIL;
