+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_dt295_protocol.c b/tests/test_dt295_protocol.c
new file mode 100644
index 0000000..9db65fa
--- /dev/null
+++ b/tests/test_dt295_protocol.c
@@ -0,0 +1,496 @@
+/* Deterministic protocol transcript with synthetic assets and a memory USB. */
+#include "crypto.h"
+#include "dt295.h"
+#include "dt295_crypto.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define MEMSIZE 0x1000000u
+typedef struct {
+    uint8_t *mem;
+    uint64_t now;
+    uint8_t material[0x1280];
+    uint8_t iv[16];
+    uint8_t ts_iv[16];
+    uint8_t session[16];
+    unsigned key_requests, i2c_commands, key_words, acquire_commands;
+    unsigned auth_requests, init_commands, shutdown_commands, start_commands;
+    unsigned renewal_challenges, renewal_applies;
+    uint32_t fail_secure_id;
+    int pause_pending, fail_state_read_once, inject_post_auth_fault;
+} fake;
+int random_bytes(void *p, size_t n) {
+    memset(p, 0, n);
+    return 0;
+}
+
+static uint16_t rd16(const uint8_t *p) {
+    return (uint16_t)p[0] << 8 | p[1];
+}
+static void wr16(uint8_t *p, uint16_t x) {
+    p[0] = x >> 8;
+    p[1] = x;
+}
+static uint32_t rd32(const uint8_t *p) {
+    return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+static void wr32(uint8_t *p, uint32_t x) {
+    p[0] = x >> 24;
+    p[1] = x >> 16;
+    p[2] = x >> 8;
+    p[3] = x;
+}
+static void cmac_key(fake *f, uint32_t a, uint32_t b, const uint8_t *data, size_t n,
+                     uint8_t out[16]) {
+    uint8_t key[16];
+    memcpy(key, f->material + (a - 0x841d0), 16);
+    for (unsigned i = 0; i < 16; i++)
+        key[i] ^= f->material[(b - 0x841d0) + i];
+    dt295_cmac(key, data, n, out);
+    secure_clear(key, 16);
+}
+
+static void respond(fake *f, uint32_t id) {
+    uint8_t request[512];
+    memcpy(request, f->mem + 0x83000, sizeof(request));
+    uint8_t *req = request, *resp = f->mem + 0x83000;
+    uint32_t got = rd32(req);
+    assert(got == id);
+    memset(resp, 0, 512);
+    wr32(resp, id);
+    wr32(resp + 4, 0);
+    if (id == 0x01010000) {
+        uint8_t initial[32] = {0};
+        uint32_t v[8] = {0x7e0, 6, 14, 0x578, 1, 3, 2, 12};
+        for (unsigned i = 0; i < 8; i++) {
+            initial[4 * i] = v[i];
+            initial[4 * i + 1] = v[i] >> 8;
+            initial[4 * i + 2] = v[i] >> 16;
+            initial[4 * i + 3] = v[i] >> 24;
+        }
+        assert(memcmp(req + 16, initial, 32) == 0);
+        wr32(resp + 8, 9);
+        for (unsigned i = 0; i < 36; i++)
+            resp[16 + i] = (uint8_t)(0x31 + i * 7);
+    } else if (id == 0x01020000) {
+        uint8_t challenge[36];
+        for (unsigned i = 0; i < 36; i++)
+            challenge[i] = (uint8_t)(0x31 + i * 7);
+        uint8_t select_data[32], mac[16], row[32], input[64], reply[20], session_input[64],
+            session_mac[16];
+        memcpy(select_data, f->material + (0x85148 - 0x841d0), 30);
+        select_data[30] = challenge[32];
+        select_data[31] = 0;
+        cmac_key(f, 0x85198, 0x851d8, select_data, 32, mac);
+        unsigned selector = mac[15] & 15;
+        memcpy(row, f->material + (0x85230 - 0x841d0) + 32 * selector, 32);
+        memcpy(input, challenge, 32);
+        memcpy(input + 32, row, 32);
+        cmac_key(f, 0x851a8, 0x851e8, input, 64, reply);
+        memset(reply + 16, 0, 4);
+        if (memcmp(req + 16, reply, 20) != 0) {
+            fprintf(stderr, "auth reply mismatch selector=%u id=%08x words=%u\n", selector,
+                    rd32(req), rd32(req + 8));
+            for (unsigned i = 0; i < 20; i++)
+                fprintf(stderr, "%02x", req[16 + i]);
+            fprintf(stderr, "\n");
+            for (unsigned i = 0; i < 20; i++)
+                fprintf(stderr, "%02x", reply[i]);
+            fprintf(stderr, "\n");
+            abort();
+        }
+        memcpy(session_input, reply, 20);
+        memcpy(session_input + 20, row, 32);
+        memcpy(session_input + 52, f->material + (0x85168 - 0x841d0), 12);
+        cmac_key(f, 0x851b8, 0x851f8, session_input, 64, session_mac);
+        memcpy(f->session, session_mac + 12, 4);
+        memcpy(f->session + 4, session_mac + 8, 4);
+        memcpy(f->session + 8, session_mac, 8);
+        memcpy(f->iv, f->material + (0x85218 - 0x841d0), 16);
+        wr32(resp + 8, 0);
+        f->auth_requests++;
+    } else if (id == 0x07010600) {
+        f->key_requests++;
+        unsigned words = f->key_words ? f->key_words : 4;
+        wr32(resp + 8, words);
+        for (unsigned i = 0; i < words * 4; i++)
+            resp[16 + i] = (uint8_t)(0x70 + i);
+    } else if (id == 0x02010200) {
+        f->renewal_challenges++;
+        wr32(resp + 8, 8);
+        for (unsigned i = 0; i < 32; i++)
+            resp[16 + i] = (uint8_t)(0xa0 + i);
+    } else if (id == 0x02020400) {
+        f->renewal_applies++;
+        uint8_t plain[496];
+        memcpy(plain, req + 12, sizeof(plain));
+        assert(dt295_payload(f->session, f->iv, plain, sizeof(plain)) == 0);
+        assert(rd32(plain) == 0xffffffff);
+        uint8_t input[64], want[16];
+        for (unsigned i = 0; i < 32; i++)
+            input[i] = (uint8_t)(0xa0 + i);
+        memcpy(input + 32, f->material + (0x85178 - 0x841d0), 28);
+        input[60] = 0;
+        input[61] = 0;
+        input[62] = 0;
+        input[63] = 1;
+        cmac_key(f, 0x851c8, 0x85208, input, 64, want);
+        assert(memcmp(plain + 4, want, 16) == 0);
+        assert(memcmp(plain + 20, (uint8_t[4]){0}, 4) == 0);
+        wr32(resp + 8, 0);
+        secure_clear(plain, sizeof(plain));
+    } else
+        assert(!"unexpected secure command");
+    if (id & 0x200) {
+        if (dt295_cbc_encrypt(f->session, f->iv, resp + 12, 496))
+            abort();
+    }
+    wr16(f->mem + 0x80014, (uint16_t)(8u << 8));
+    wr16(f->mem + 0x90074, (uint16_t)(rd16(f->mem + 0x90074) | 8));
+}
+
+static int control(void *u, uint8_t rt, uint8_t req, uint16_t value, uint16_t index, uint8_t *data,
+                   size_t n, unsigned timeout, size_t *actual) {
+    (void)timeout;
+    fake *f = u;
+    *actual = n;
+    if (req == 0xbc) {
+        uint32_t addr = (uint32_t)(value >> 8) << 16 | index;
+        if (addr + n > MEMSIZE)
+            return -1;
+        if ((rt & 0x80) && addr == 0x82008 && f->fail_state_read_once) {
+            f->fail_state_read_once = 0;
+            return -1;
+        }
+        if (rt & 0x80)
+            memcpy(data, f->mem + addr, n);
+        else if (addr == 0x90074 && n == 2)
+            wr16(f->mem + addr, (uint16_t)(rd16(f->mem + addr) & ~rd16(data)));
+        else
+            memcpy(f->mem + addr, data, n);
+        return 0;
+    }
+    if (req == 0xb8 || req == 0xb9) {
+        if (n != 4)
+            return -1;
+        uint8_t cmd = data[0], sub = data[1];
+        uint16_t val = rd16(data + 2);
+        if (cmd == 8 && f->fail_secure_id && f->fail_secure_id == rd32(f->mem + 0x83000)) {
+            f->fail_secure_id = 0;
+            return -1;
+        } else if (cmd == 8)
+            respond(f, rd32(f->mem + 0x83000));
+        else if (req == 0xb9) {
+            f->i2c_commands++;
+            wr16(f->mem + 0x80016, (uint16_t)(cmd << 8));
+            wr16(f->mem + 0x823be, 0);
+            uint16_t bits = (uint16_t)(2 | (cmd == 9 ? 0x100 : 0));
+            wr16(f->mem + 0x90074, (uint16_t)(rd16(f->mem + 0x90074) | bits));
+        } else {
+            wr16(f->mem + 0x80014, (uint16_t)(cmd << 8));
+            uint16_t state = rd16(f->mem + 0x82008);
+            if (cmd == 1) {
+                f->init_commands++;
+                state = 0x11;
+                if (f->inject_post_auth_fault) {
+                    f->inject_post_auth_fault = 0;
+                    f->fail_state_read_once = 1;
+                }
+            }
+            else if (cmd == 4 && sub == 1)
+                state = 0x10;
+            else if (cmd == 4 && sub == 0x20) {
+                assert(val == 0);
+                f->acquire_commands++;
+                state = 1;
+            } else if (cmd == 4 && val == 0x20) {
+                assert(!"acquire must use command 4/subcommand 0x20/value 0");
+            }
+            else if (cmd == 4 && sub == 0 && val == 1)
+                f->shutdown_commands++;
+            else if (cmd == 5 && val == 2) {
+                f->start_commands++;
+                state = 2;
+            }
+            else if (cmd == 5 && val == 1)
+                state = 1;
+            else if (cmd == 5 && (val == 3 || val == 4)) {
+                f->pause_pending = 1;
+                state = 2;
+            }
+            wr16(f->mem + 0x82008, state);
+            wr16(f->mem + 0x90074, (uint16_t)(rd16(f->mem + 0x90074) | 8 | 4));
+        }
+        return 0;
+    }
+    return -1;
+}
+static int bulk(void *u, uint8_t ep, uint8_t *p, size_t n, unsigned timeout, size_t *actual) {
+    (void)p;
+    (void)timeout;
+    fake *f = u;
+    *actual = 0;
+    if (ep == 0x02) {
+        *actual = n;
+        return 0;
+    }
+    if (ep == 0x81 && f->pause_pending) {
+        f->pause_pending = 0;
+        wr16(f->mem + 0x82008, 4);
+        wr16(f->mem + 0x90074, (uint16_t)(rd16(f->mem + 0x90074) | 4));
+        return -7;
+    }
+    if (ep == 0x81)
+        return -7;
+    return -1;
+}
+static int interrupt(void *u, uint8_t ep, uint8_t *p, size_t n, unsigned timeout, size_t *actual) {
+    (void)u;
+    (void)ep;
+    (void)p;
+    (void)n;
+    (void)timeout;
+    *actual = 0;
+    return -7;
+}
+static uint64_t now(void *u) {
+    return ((fake *)u)->now;
+}
+static void sleep_fake(void *u, unsigned ms) {
+    ((fake *)u)->now += ms;
+}
+
+static void create_assets(const char *path, fake *f) {
+    uint8_t idle[1] = {0x11}, trc[1] = {0x22}, field[8] = {0},
+            keyreq[12] = {0, 0, 0, 1, 0, 0, 0, 2, 0, 0, 0, 3};
+    for (size_t i = 0; i < sizeof(f->material); i++)
+        f->material[i] = (uint8_t)(i * 17 + 3);
+    memset(f->material, 0, 22 * 8);
+    memset(f->material + (0x84630 - 0x841d0), 0, 26 * 8);
+    memset(f->material + (0x84700 - 0x841d0), 0, 28 * 8);
+    memcpy(f->material + (0x85218 - 0x841d0), (uint8_t[16]){0}, 16);
+    memset(f->iv, 0, 16);
+    for (unsigned i = 0; i < sizeof(f->ts_iv); i++)
+        f->ts_iv[i] = (uint8_t)(0xa0 + i);
+    assert(memcmp(f->ts_iv, f->material + (0x85218 - 0x841d0), 16) != 0);
+    field[0] = 0x00;
+    field[1] = 0x10;
+    field[2] = 0;
+    field[3] = 1;
+    field[4] = 1; /* address 1000, bit 0 = 1 */
+    FILE *fp = fopen(path, "wb");
+    assert(fp);
+    assert(fwrite("D295A1\0\0", 1, 8, fp) == 8);
+    uint8_t sections[6][1] = {{0}};
+    (void)sections;
+    uint8_t *items[6] = {idle, trc, f->material, field, keyreq, f->ts_iv};
+    size_t sizes[6] = {sizeof(idle),  sizeof(trc),    sizeof(f->material),
+                       sizeof(field), sizeof(keyreq), sizeof(f->ts_iv)};
+    uint8_t header[6 * 36];
+    for (unsigned i = 0; i < 6; i++) {
+        uint32_t n = (uint32_t)sizes[i];
+        header[i * 36] = (uint8_t)n;
+        header[i * 36 + 1] = (uint8_t)(n >> 8);
+        header[i * 36 + 2] = (uint8_t)(n >> 16);
+        header[i * 36 + 3] = (uint8_t)(n >> 24);
+        dt295_sha256(items[i], sizes[i], header + i * 36 + 4);
+    }
+    assert(fwrite(header, 1, sizeof(header), fp) == sizeof(header));
+    for (unsigned i = 0; i < 6; i++)
+        assert(fwrite(items[i], 1, sizes[i], fp) == sizes[i]);
+    assert(fclose(fp) == 0);
+}
+static void rewrite_asset_file(const char *path, const uint8_t *bytes, size_t n) {
+    FILE *fp = fopen(path, "wb");
+    assert(fp);
+    assert(fwrite(bytes, 1, n, fp) == n);
+    assert(fclose(fp) == 0);
+}
+static void test_asset_rejection(const char *path) {
+    FILE *fp = fopen(path, "rb");
+    assert(fp);
+    assert(fseek(fp, 0, SEEK_END) == 0);
+    long sz = ftell(fp);
+    assert(sz > 0);
+    assert(fseek(fp, 0, SEEK_SET) == 0);
+    uint8_t *data = malloc((size_t)sz);
+    assert(data);
+    assert(fread(data, 1, (size_t)sz, fp) == (size_t)sz);
+    fclose(fp);
+    dt295_assets *a = NULL;
+    char error[128];
+    uint8_t saved[4];
+    memcpy(saved, data + 8, 4);
+    memset(data + 8, 0xff, 4);
+    rewrite_asset_file(path, data, (size_t)sz);
+    assert(dt295_assets_load(path, &a, error, sizeof(error)) < 0 && a == NULL);
+    memcpy(data + 8, saved, 4);
+    data[12] ^= 1;
+    rewrite_asset_file(path, data, (size_t)sz);
+    assert(dt295_assets_load(path, &a, error, sizeof(error)) < 0 && a == NULL);
+    rewrite_asset_file(path, data, 12);
+    assert(dt295_assets_load(path, &a, error, sizeof(error)) < 0 && a == NULL);
+    memcpy(data + 12, (uint8_t[1]){(uint8_t)(data[12] ^ 1)}, 1);
+    rewrite_asset_file(path, data, (size_t)sz);
+    free(data);
+}
+
+static void test_authenticated_setup_failure_cleanup(const dt295_assets *assets,
+                                                     const fake *source) {
+    fake f = {0};
+    f.mem = calloc(1, MEMSIZE);
+    assert(f.mem);
+    f.now = 1000;
+    memcpy(f.material, source->material, sizeof(f.material));
+    wr16(f.mem + 0x82008, 0x10);
+    f.mem[0x822ac] = 0x30;
+    f.inject_post_auth_fault = 1;
+    dt295_io io = {&f, control, bulk, interrupt, now, sleep_fake};
+    dt295 *d = NULL;
+    char error[256];
+    assert(dt295_create(&d, &io, assets, error, sizeof(error)) == 0);
+    assert(dt295_boot(d, error, sizeof(error)) == 0);
+    assert(dt295_open_session(d, error, sizeof(error)) < 0);
+    assert(strcmp(error,
+                  "DT295 authentication failed; state-changing request was not retried") == 0);
+    assert(dt295_has_session(d));
+    assert(f.auth_requests == 1 && f.init_commands == 1);
+
+    /* The retained session is cleanup-only: setup, renewal, and start paths
+     * must not issue a second initialization or any new state-changing work. */
+    dt295_route_plan empty = {0};
+    assert(dt295_card_initialize(d, error, sizeof(error)) < 0);
+    assert(dt295_card_activate(d, 1000, error, sizeof(error)) < 0);
+    assert(dt295_tune_terrestrial(d, 27, error, sizeof(error)) < 0);
+    assert(dt295_prepare_plan(d, &empty, error, sizeof(error)) < 0);
+    assert(dt295_start(d, error, sizeof(error)) < 0);
+    int renewed = 0;
+    assert(dt295_renew_if_due(d, &renewed, error, sizeof(error)) < 0 && renewed == 0);
+    assert(dt295_open_session(d, error, sizeof(error)) < 0);
+    assert(f.auth_requests == 1 && f.init_commands == 1 && f.start_commands == 0);
+
+    size_t drained = 0;
+    assert(dt295_stop(d, &drained, error, sizeof(error)) == 0);
+    assert(dt295_state(d) == 0x11);
+    assert(dt295_shutdown(d, error, sizeof(error)) == 0);
+    assert(f.shutdown_commands == 1 && !dt295_has_session(d));
+    dt295_destroy(d);
+    free(f.mem);
+}
+
+int main(void) {
+    const char *path = "tests/.dt295-synthetic-assets.tmp";
+    fake f = {0};
+    f.mem = calloc(1, MEMSIZE);
+    assert(f.mem);
+    f.now = 1000;
+    wr16(f.mem + 0x82008, 0x10);
+    f.mem[0x822ac] = 0x30;
+    create_assets(path, &f);
+    test_asset_rejection(path);
+    dt295_assets *assets = NULL;
+    char error[256];
+    assert(dt295_assets_load(path, &assets, error, sizeof(error)) == 0);
+    remove(path);
+    test_authenticated_setup_failure_cleanup(assets, &f);
+    dt295_io io = {&f, control, bulk, interrupt, now, sleep_fake};
+    dt295 *d = NULL;
+    assert(dt295_create(&d, &io, assets, error, sizeof(error)) == 0);
+    assert(dt295_boot(d, error, sizeof(error)) == 0);
+    if (dt295_open_session(d, error, sizeof(error)) != 0) {
+        fprintf(stderr, "open_session: %s\n", error);
+        abort();
+    }
+    assert(dt295_has_session(d));
+    assert(dt295_card_initialize(d, error, sizeof(error)) == 0);
+    assert(dt295_card_activate(d, 2000, error, sizeof(error)) == 0);
+    if (dt295_tune_terrestrial(d, 27, error, sizeof(error)) != 0) {
+        fprintf(stderr, "tune: %s (%u I2C commands pending=%04x)\n", error, f.i2c_commands,
+                rd16(f.mem + 0x90074));
+        abort();
+    }
+    dt295_route_plan plan = {0};
+    plan.routes[0] = (dt295_route){0, 1, 0, 0, 0x301, 6};
+    plan.routes[1] = (dt295_route){1, 1, 0, 0, 0x302, 63};
+    plan.routes[4] = (dt295_route){4, 1, 0, 0, 0, 0};
+    plan.routes[6] = (dt295_route){6, 1, 1, 0, 0x206, 6};
+    plan.routes[39] = (dt295_route){39, 1, 0, 0, 0x101, 0};
+    plan.routes[40] = (dt295_route){40, 1, 0, 0, 0x102, 0};
+    plan.routes[63] = (dt295_route){63, 1, 1, 0, 0x3ff, 63};
+    plan.route_count = 7;
+    plan.primary_program = 0x1234;
+    plan.video_stream_type = 2;
+    plan.audio_stream_type = 4;
+    wr16(f.mem + 0x1070, 0xffff);
+    if (dt295_prepare_plan(d, &plan, error, sizeof(error)) != 0) {
+        fprintf(stderr, "prepare: %s\n", error);
+        abort();
+    }
+    assert(f.key_requests == 1);
+    assert(rd16(f.mem + 0x1018) == 0x1234);
+    assert(rd16(f.mem + 0x101c) == 0x0204);
+    assert(rd16(f.mem + 0x101e) == 0x8301);
+    assert(rd16(f.mem + 0x1020) == 0x8302);
+    assert(rd16(f.mem + 0x10a2) == 0x063f);
+    assert(rd16(f.mem + 0x10a6) == 0);
+    assert(rd16(f.mem + 0x10a8) == 0x0600);
+    assert(rd16(f.mem + 0x106c) == 0x8101);
+    assert(rd16(f.mem + 0x106e) == 0x8102);
+    assert(rd16(f.mem + 0x1070) == 0);
+    assert(rd16(f.mem + 0x109c) == 0x83ff);
+    assert(rd16(f.mem + 0x10e0) == 0x003f);
+    assert(dt295_start(d, error, sizeof(error)) == 0);
+    assert(f.acquire_commands == 1);
+    size_t drained = 0;
+    assert(dt295_stop(d, &drained, error, sizeof(error)) == 0);
+    assert(dt295_state(d) == 0x11);
+    if (dt295_reprepare_plan(d, &plan, error, sizeof(error)) != 0) {
+        fprintf(stderr, "reprepare: %s\n", error);
+        abort();
+    }
+    assert(f.key_requests == 1);
+    assert(f.acquire_commands == 2);
+    assert(dt295_start(d, error, sizeof(error)) == 0);
+    assert(dt295_stop(d, &drained, error, sizeof(error)) == 0);
+    f.now += 30000;
+    int renewed = 0;
+    f.fail_secure_id = 0x02020400;
+    assert(dt295_renew_if_due(d, &renewed, error, sizeof(error)) < 0 && renewed == 0);
+    assert(f.renewal_challenges == 1 && f.renewal_applies == 0);
+    /* A failed renewal leaves its original deadline and counter intact. */
+    assert(dt295_renew_if_due(d, &renewed, error, sizeof(error)) == 0 && renewed == 1);
+    assert(f.renewal_challenges == 2 && f.renewal_applies == 1);
+    assert(dt295_shutdown(d, error, sizeof(error)) == 0);
+    assert(dt295_state(d) == 0x10);
+    assert(!dt295_has_session(d));
+    dt295_destroy(d);
+    free(f.mem);
+
+    /* Malformed oversized key response must be rejected before touching the
+     * 16-byte in-context TS-key buffer (ASan/UBSan run by the test target). */
+    fake bad = {0};
+    bad.mem = calloc(1, MEMSIZE);
+    assert(bad.mem);
+    bad.now = 1000;
+    bad.key_words = 5;
+    memcpy(bad.material, f.material, sizeof(bad.material));
+    memcpy(bad.iv, f.iv, sizeof(bad.iv));
+    wr16(bad.mem + 0x82008, 0x10);
+    bad.mem[0x822ac] = 0x30;
+    dt295_io bad_io = {&bad, control, bulk, interrupt, now, sleep_fake};
+    dt295 *bad_device = NULL;
+    assert(dt295_create(&bad_device, &bad_io, assets, error, sizeof(error)) == 0);
+    assert(dt295_boot(bad_device, error, sizeof(error)) == 0);
+    assert(dt295_open_session(bad_device, error, sizeof(error)) == 0);
+    assert(dt295_card_initialize(bad_device, error, sizeof(error)) == 0);
+    assert(dt295_card_activate(bad_device, 2000, error, sizeof(error)) == 0);
+    assert(dt295_tune_terrestrial(bad_device, 27, error, sizeof(error)) == 0);
+    assert(dt295_prepare_plan(bad_device, &plan, error, sizeof(error)) < 0);
+    assert(bad.key_requests == 1);
+    dt295_destroy(bad_device);
+    dt295_assets_free(assets);
+    free(bad.mem);
+    return 0;
+}
diff --git a/tests/test_dt295_routes.c b/tests/test_dt295_routes.c
new file mode 100644
index 0000000..f6402e7
--- /dev/null
+++ b/tests/test_dt295_routes.c
@@ -0,0 +1,527 @@
+/* SPDX-License-Identifier: MIT */
+#include "dt295_routes.h"
+#include "transport.h"
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define TEST_SECTION_MAX 1024u
+
+static uint32_t mpeg_crc(const uint8_t *p, size_t n) {
+    uint32_t crc = 0xffffffffu;
+    for (size_t i = 0; i < n; ++i) {
+        crc ^= (uint32_t)p[i] << 24;
+        for (unsigned b = 0; b < 8; ++b)
+            crc = crc & 0x80000000u ? (crc << 1) ^ 0x04c11db7u : crc << 1;
+    }
+    return crc;
+}
+static size_t make_table(uint8_t *out, uint8_t tid, uint16_t ext, unsigned version, unsigned number,
+                         unsigned last, const uint8_t *payload, size_t payload_n) {
+    size_t total = 12 + payload_n, section_length = total - 3;
+    out[0] = tid;
+    out[1] = (uint8_t)(0xb0 | (section_length >> 8));
+    out[2] = (uint8_t)section_length;
+    out[3] = (uint8_t)(ext >> 8);
+    out[4] = (uint8_t)ext;
+    out[5] = (uint8_t)(0xc1 | ((version & 31) << 1));
+    out[6] = (uint8_t)number;
+    out[7] = (uint8_t)last;
+    if (payload_n)
+        memcpy(out + 8, payload, payload_n);
+    uint32_t crc = mpeg_crc(out, total - 4);
+    out[total - 4] = (uint8_t)(crc >> 24);
+    out[total - 3] = (uint8_t)(crc >> 16);
+    out[total - 2] = (uint8_t)(crc >> 8);
+    out[total - 1] = (uint8_t)crc;
+    assert(ts_crc(out, total) == 0);
+    return total;
+}
+static unsigned continuity[8192];
+static void feed_section(dt295_routes *r, uint16_t pid, const uint8_t *section, size_t n) {
+    assert(n <= 183);
+    uint8_t p[188];
+    memset(p, 0xff, sizeof(p));
+    p[0] = 0x47;
+    p[1] = (uint8_t)(0x40 | (pid >> 8));
+    p[2] = (uint8_t)pid;
+    p[3] = (uint8_t)(0x10 | (continuity[pid]++ & 15));
+    p[4] = 0;
+    memcpy(p + 5, section, n);
+    assert(dt295_routes_feed(r, p) == 0);
+}
+static size_t make_pat(uint8_t *b, unsigned ver, unsigned sn, unsigned last, uint16_t program,
+                       uint16_t pmt_pid) {
+    uint8_t entry[4] = {(uint8_t)(program >> 8), (uint8_t)program, (uint8_t)(0xe0 | (pmt_pid >> 8)),
+                        (uint8_t)pmt_pid};
+    return make_table(b, 0, 0x1234, ver, sn, last, entry, sizeof(entry));
+}
+static size_t make_pat_av_and_data(uint8_t *b, unsigned ver) {
+    uint8_t entries[8] = {
+        0x00, 0x01, 0xe1, 0x00, /* program 1 -> PMT PID 0x100 */
+        0xff, 0xf0, 0xfc, 0xf0, /* program 65520 -> PMT PID 7408 */
+    };
+    return make_table(b, 0, 0x1234, ver, 0, 0, entries, sizeof(entries));
+}
+static size_t make_cat(uint8_t *b, unsigned ver, uint16_t ecm_pid) {
+    uint8_t desc[6] = {0xf6, 0x04, 0x00, 0x05, (uint8_t)(0xe0 | (ecm_pid >> 8)), (uint8_t)ecm_pid};
+    return make_table(b, 1, 1, ver, 0, 0, desc, sizeof(desc));
+}
+static size_t make_empty_cat(uint8_t *b, unsigned ver) {
+    return make_table(b, 1, 1, ver, 0, 0, NULL, 0);
+}
+static size_t make_pmt(uint8_t *b, unsigned ver, uint16_t program, uint16_t pmt_pid,
+                       uint16_t ecm_pid, int ca) {
+    uint8_t data[64];
+    size_t n = 0;
+    uint16_t video = (uint16_t)(0x101 + (program - 1) * 2), audio = (uint16_t)(video + 1);
+    (void)pmt_pid;
+    data[n++] = (uint8_t)(0xe0 | (video >> 8));
+    data[n++] = (uint8_t)video;
+    size_t pil = ca ? 6 : 0;
+    data[n++] = (uint8_t)(0xf0 | (pil >> 8));
+    data[n++] = (uint8_t)pil;
+    if (ca) {
+        data[n++] = 0x09;
+        data[n++] = 4;
+        data[n++] = 0;
+        data[n++] = 5;
+        data[n++] = (uint8_t)(0xe0 | (ecm_pid >> 8));
+        data[n++] = (uint8_t)ecm_pid;
+    }
+    data[n++] = 0x1b;
+    data[n++] = (uint8_t)(0xe0 | (video >> 8));
+    data[n++] = (uint8_t)video;
+    data[n++] = 0xf0;
+    data[n++] = 0;
+    data[n++] = 0x0f;
+    data[n++] = (uint8_t)(0xe0 | (audio >> 8));
+    data[n++] = (uint8_t)audio;
+    data[n++] = 0xf0;
+    data[n++] = 0;
+    return make_table(b, 2, program, ver, 0, 0, data, n);
+}
+static size_t make_pmt_video_only(uint8_t *b, unsigned ver, uint16_t program, uint16_t ecm_pid) {
+    uint8_t data[32];
+    size_t n = 0;
+    uint16_t video = 0x101;
+    data[n++] = (uint8_t)(0xe0 | (video >> 8));
+    data[n++] = (uint8_t)video;
+    data[n++] = 0xf0;
+    data[n++] = 6;
+    data[n++] = 0x09;
+    data[n++] = 4;
+    data[n++] = 0;
+    data[n++] = 5;
+    data[n++] = (uint8_t)(0xe0 | (ecm_pid >> 8));
+    data[n++] = (uint8_t)ecm_pid;
+    data[n++] = 0x1b;
+    data[n++] = (uint8_t)(0xe0 | (video >> 8));
+    data[n++] = (uint8_t)video;
+    data[n++] = 0xf0;
+    data[n++] = 0;
+    return make_table(b, 2, program, ver, 0, 0, data, n);
+}
+static size_t make_pmt_extra_aac(uint8_t *b, unsigned ver, uint16_t program, uint16_t ecm_pid,
+                                 uint16_t extra_pid, int include_extra) {
+    uint8_t data[48];
+    size_t n = 0;
+    uint16_t video = 0x101, audio = 0x102;
+    data[n++] = (uint8_t)(0xe0 | (video >> 8));
+    data[n++] = (uint8_t)video;
+    data[n++] = 0xf0;
+    data[n++] = 6;
+    data[n++] = 0x09;
+    data[n++] = 4;
+    data[n++] = 0;
+    data[n++] = 5;
+    data[n++] = (uint8_t)(0xe0 | (ecm_pid >> 8));
+    data[n++] = (uint8_t)ecm_pid;
+    data[n++] = 0x1b;
+    data[n++] = (uint8_t)(0xe0 | (video >> 8));
+    data[n++] = (uint8_t)video;
+    data[n++] = 0xf0;
+    data[n++] = 0;
+    data[n++] = 0x0f;
+    data[n++] = (uint8_t)(0xe0 | (audio >> 8));
+    data[n++] = (uint8_t)audio;
+    data[n++] = 0xf0;
+    data[n++] = 0;
+    if (include_extra) {
+        data[n++] = 0x0f;
+        data[n++] = (uint8_t)(0xe0 | (extra_pid >> 8));
+        data[n++] = (uint8_t)extra_pid;
+        data[n++] = 0xf0;
+        data[n++] = 0;
+    }
+    return make_table(b, 2, program, ver, 0, 0, data, n);
+}
+static size_t make_pmt_two_program_ecms(uint8_t *b, unsigned ver, uint16_t program,
+                                         uint16_t first_ecm, uint16_t second_ecm) {
+    uint8_t data[64];
+    size_t n = 0;
+    uint16_t video = 0x101, audio = 0x102;
+    data[n++] = (uint8_t)(0xe0 | (video >> 8));
+    data[n++] = (uint8_t)video;
+    data[n++] = 0xf0;
+    data[n++] = 12;
+    for (unsigned i = 0; i < 2; ++i) {
+        uint16_t ecm = i ? second_ecm : first_ecm;
+        data[n++] = 0x09;
+        data[n++] = 4;
+        data[n++] = 0;
+        data[n++] = 5;
+        data[n++] = (uint8_t)(0xe0 | (ecm >> 8));
+        data[n++] = (uint8_t)ecm;
+    }
+    data[n++] = 0x1b;
+    data[n++] = (uint8_t)(0xe0 | (video >> 8));
+    data[n++] = (uint8_t)video;
+    data[n++] = 0xf0;
+    data[n++] = 0;
+    data[n++] = 0x0f;
+    data[n++] = (uint8_t)(0xe0 | (audio >> 8));
+    data[n++] = (uint8_t)audio;
+    data[n++] = 0xf0;
+    data[n++] = 0;
+    return make_table(b, 2, program, ver, 0, 0, data, n);
+}
+static size_t make_pmt_data_only_no_pcr(uint8_t *b, unsigned ver, uint16_t program,
+                                        uint16_t es_pid) {
+    uint8_t data[9];
+    size_t n = 0;
+    data[n++] = 0xff;
+    data[n++] = 0xff; /* PCR_PID == 0x1fff: no PCR */
+    data[n++] = 0xf0;
+    data[n++] = 0;
+    data[n++] = 0x06; /* private data stream */
+    data[n++] = (uint8_t)(0xe0 | (es_pid >> 8));
+    data[n++] = (uint8_t)es_pid;
+    data[n++] = 0xf0;
+    data[n++] = 0;
+    return make_table(b, 2, program, ver, 0, 0, data, n);
+}
+static void feed_pat(dt295_routes *r, unsigned ver, unsigned sn, unsigned last, uint16_t program,
+                     uint16_t pid) {
+    uint8_t b[TEST_SECTION_MAX];
+    size_t n = make_pat(b, ver, sn, last, program, pid);
+    feed_section(r, 0, b, n);
+}
+static void bootstrap(dt295_routes *r, dt295_route_plan *live) {
+    char error[DT295_ROUTE_ERROR];
+    dt295_route_plan plan, candidate;
+    dt295_route_op ops[DT295_ROUTE_OP_LIMIT];
+    size_t count;
+    assert(dt295_routes_initial_plan(r, &plan, error) == 0);
+    assert(dt295_routes_initial_ops(&plan, ops, &count, error) == 0);
+    memset(live, 0, sizeof(*live));
+    live->routes[4] = (dt295_route){4, 1, 0, 0, 0, 0};
+    live->route_count = 1;
+    assert(dt295_routes_guard(live, ops, count, &candidate, error) == 0);
+    dt295_routes_commit(live, &candidate);
+}
+
+static void test_completeness_versions_and_planning(void) {
+    memset(continuity, 0, sizeof(continuity));
+    dt295_routes *r = dt295_routes_create();
+    assert(r);
+    dt295_routes_snapshot s;
+    feed_pat(r, 31, 0, 1, 1, 0x100);
+    dt295_routes_snapshot_get(r, &s);
+    assert(!s.have_pat);
+    feed_pat(r, 31, 1, 1, 2, 0x110);
+    dt295_routes_snapshot_get(r, &s);
+    assert(s.have_pat && s.program_count == 2 && !s.ready && s.missing_pmts == 2);
+    /* The current CAT is part of acquisition readiness; CAT/PAT versions are independent. */
+    uint8_t b[TEST_SECTION_MAX];
+    size_t n = make_cat(b, 0, 0x1ef);
+    feed_section(r, 1, b, n);
+    feed_pat(r, 0, 0, 1, 1, 0x100);
+    feed_pat(r, 0, 1, 1, 2, 0x110);
+    dt295_routes_snapshot_get(r, &s);
+    assert(s.have_pat && s.have_cat && s.missing_pmts == 2 && !s.ready);
+    feed_pat(r, 31, 0, 1, 9, 0x120); /* delayed previous version is ignored */
+    feed_pat(r, 30, 0, 1, 9, 0x120); /* older versions cannot roll the route map back */
+    feed_pat(r, 16, 0, 1, 9, 0x120); /* half-cycle ordering is unknown and fails closed */
+    dt295_routes_snapshot_get(r, &s);
+    assert(s.program_count == 2 && s.programs[0].program == 1 && s.unsupported_tables > 0);
+    dt295_route_plan live;
+    bootstrap(r, &live);
+    for (unsigned i = 0; i < 64; ++i)
+        assert(!live.routes[i].enabled ||
+               (live.routes[i].pid != 0x1ed && live.routes[i].pid != 0x1ef));
+    n = make_pmt(b, 0, 1, 0x100, 0x1ed, 1);
+    feed_section(r, 0x100, b, n);
+    n = make_pmt(b, 0, 2, 0x110, 0, 0);
+    feed_section(r, 0x110, b, n);
+    dt295_routes_snapshot_get(r, &s);
+    assert(s.ready && s.missing_pmts == 0);
+    dt295_route_plan desired, candidate;
+    char error[DT295_ROUTE_ERROR];
+    assert(dt295_routes_build(r, 1, &live, &desired, error) == 0);
+    assert(desired.ready && desired.has_primary && desired.primary_program == 1);
+    assert(desired.dedicated_pid[0] == 0x101 && desired.dedicated_pid[3] == 0x101);
+    assert(desired.video_stream_type == 0x1b && desired.audio_stream_type == 0x0f);
+    int cat_ca_routed = 0;
+    for (unsigned i = 0; i < 64; ++i)
+        if (desired.routes[i].enabled && desired.routes[i].pid == 0x1ef)
+            cat_ca_routed = 1;
+    assert(cat_ca_routed);
+    int ecm_slot = -1, video_slot = -1;
+    for (unsigned i = 0; i < 64; ++i)
+        if (desired.routes[i].enabled) {
+            if (desired.routes[i].is_ecm && desired.routes[i].pid == 0x1ed)
+                ecm_slot = (int)i;
+            if (desired.routes[i].pid == 0x101)
+                video_slot = (int)i;
+        }
+    assert(ecm_slot >= 5 && video_slot >= 0 && desired.routes[video_slot].ecm_slot == ecm_slot);
+    dt295_route_op ops[DT295_ROUTE_OP_LIMIT];
+    size_t count;
+    assert(dt295_routes_plan_ops(&live, &desired, ops, &count, error) == 0);
+    assert(count > 0 && ops[0].slot == ecm_slot); /* ECM is registered before its streams. */
+    assert(dt295_routes_guard(&live, ops, count, &candidate, error) == 0);
+    dt295_routes_commit(&live, &candidate);
+    assert(dt295_routes_build(r, 1, &live, &desired, error) ==
+           0); /* retained nontrivial ECM PID/slot */
+    assert(desired.routes[ecm_slot].pid == 0x1ed && desired.routes[ecm_slot].is_ecm);
+    live = desired; /* model the post-reprepare configured plan */
+    /* A later PMT may advertise an additional AAC PID under the same active ECM.
+     * It gets one genuinely free slot; repeats and disappearance/reappearance
+     * retain that registration without producing another operation. */
+    n = make_pmt_extra_aac(b, 1, 1, 0x1ed, 0x111, 1);
+    feed_section(r, 0x100, b, n);
+    assert(dt295_routes_build(r, 1, &live, &desired, error) == 0);
+    int extra_slot = -1;
+    for (unsigned i = 0; i < DT295_SLOT_COUNT; ++i)
+        if (desired.routes[i].enabled && desired.routes[i].pid == 0x111)
+            extra_slot = (int)i;
+    assert(extra_slot >= 5 && desired.routes[extra_slot].ecm_slot == ecm_slot);
+    assert(dt295_routes_plan_ops(&live, &desired, ops, &count, error) == 0);
+    assert(count == 1 && ops[0].slot == extra_slot && ops[0].pid == 0x111 &&
+           ops[0].ecm_slot == ecm_slot);
+    assert(dt295_routes_guard(&live, ops, count, &candidate, error) == 0);
+    dt295_routes_commit(&live, &candidate);
+    n = make_pmt_extra_aac(b, 2, 1, 0x1ed, 0x111, 1);
+    feed_section(r, 0x100, b, n);
+    assert(dt295_routes_build(r, 1, &live, &desired, error) == 0);
+    assert(dt295_routes_plan_ops(&live, &desired, ops, &count, error) == 0 && count == 0);
+    n = make_pmt_extra_aac(b, 3, 1, 0x1ed, 0x111, 0);
+    feed_section(r, 0x100, b, n);
+    assert(dt295_routes_build(r, 1, &live, &desired, error) == 0);
+    assert(desired.routes[extra_slot].enabled && desired.routes[extra_slot].pid == 0x111 &&
+           desired.routes[extra_slot].ecm_slot == ecm_slot);
+    assert(dt295_routes_plan_ops(&live, &desired, ops, &count, error) == 0 && count == 0);
+    n = make_pmt_extra_aac(b, 4, 1, 0x1ed, 0x111, 1);
+    feed_section(r, 0x100, b, n);
+    assert(dt295_routes_build(r, 1, &live, &desired, error) == 0);
+    assert(desired.routes[extra_slot].enabled && desired.routes[extra_slot].pid == 0x111 &&
+           desired.routes[extra_slot].ecm_slot == ecm_slot);
+    assert(dt295_routes_plan_ops(&live, &desired, ops, &count, error) == 0 && count == 0);
+    live = desired;
+    /* A naturally disappearing audio PID stays registered without forcing a stop. */
+    n = make_pmt_video_only(b, 5, 1, 0x1ed);
+    feed_section(r, 0x100, b, n);
+    assert(dt295_routes_build(r, 0, &live, &desired, error) == 0);
+    assert(desired.dedicated_pid[1] == 0);
+    int audio_retained = 0;
+    for (unsigned i = 0; i < 64; ++i)
+        if (desired.routes[i].enabled && desired.routes[i].pid == 0x102)
+            audio_retained = 1;
+    assert(audio_retained);
+    /* A binding change on a still-advertised route is rejected after registration. */
+    n = make_pmt_video_only(b, 6, 1, 0x1ee);
+    feed_section(r, 0x100, b, n);
+    assert(dt295_routes_build(r, 0, &live, &desired, error) != 0);
+    assert(strstr(error, "rebind") != NULL);
+    dt295_routes_destroy(r);
+}
+
+static void test_stable_bootstrap_slots(void) {
+    memset(continuity, 0, sizeof(continuity));
+    dt295_routes *r = dt295_routes_create();
+    assert(r);
+    feed_pat(r, 1, 0, 0, 1, 0x100);
+    dt295_route_plan first, live, next;
+    char error[DT295_ROUTE_ERROR];
+    assert(dt295_routes_initial_plan(r, &first, error) == 0);
+    live = first;
+    unsigned pmt_slot = 0;
+    for (unsigned i = 0; i < 64; ++i)
+        if (live.routes[i].enabled && live.routes[i].pid == 0x100)
+            pmt_slot = i;
+    assert(pmt_slot >= 5);
+    feed_pat(r, 2, 0, 0, 1, 0x110);
+    assert(dt295_routes_bootstrap_plan(r, &live, &next, error) == 0);
+    for (unsigned i = 0; i < 64; ++i)
+        if (live.routes[i].enabled)
+            assert(next.routes[i].enabled && next.routes[i].pid == live.routes[i].pid);
+    int new_pmt = 0;
+    for (unsigned i = 0; i < 64; ++i)
+        if (next.routes[i].enabled && next.routes[i].pid == 0x110)
+            new_pmt = 1;
+    assert(new_pmt && next.routes[pmt_slot].pid == 0x100);
+    dt295_routes_destroy(r);
+}
+
+static void test_unsupported_multi_ecm_pmt_update_preserves_commit(void) {
+    memset(continuity, 0, sizeof(continuity));
+    dt295_routes *r = dt295_routes_create();
+    assert(r);
+    uint8_t b[TEST_SECTION_MAX];
+    feed_pat(r, 1, 0, 0, 1, 0x100);
+    size_t n = make_cat(b, 0, 0x1ed);
+    feed_section(r, 1, b, n);
+    dt295_route_plan live, before, after;
+    char error[DT295_ROUTE_ERROR];
+    bootstrap(r, &live);
+    n = make_pmt(b, 1, 1, 0x100, 0x1ed, 1);
+    feed_section(r, 0x100, b, n);
+    assert(dt295_routes_build(r, 0, &live, &before, error) == 0);
+    dt295_routes_snapshot s;
+    dt295_routes_snapshot_get(r, &s);
+    assert(s.ready && s.unsupported_tables == 0);
+
+    n = make_pmt_two_program_ecms(b, 2, 1, 0x1ed, 0x1ee);
+    feed_section(r, 0x100, b, n);
+    dt295_routes_snapshot_get(r, &s);
+    assert(s.ready && s.missing_pmts == 0 && s.unsupported_tables > 0);
+    /* The rejected update must not replace the last usable PMT/routes. */
+    assert(dt295_routes_build(r, 0, &live, &after, error) == 0);
+    assert(after.primary_program == before.primary_program);
+    assert(after.route_count == before.route_count);
+    assert(memcmp(after.routes, before.routes, sizeof(after.routes)) == 0);
+    assert(memcmp(after.dedicated_pid, before.dedicated_pid, sizeof(after.dedicated_pid)) == 0);
+    dt295_routes_destroy(r);
+}
+
+static void test_av_and_data_program_with_null_pcr(void) {
+    memset(continuity, 0, sizeof(continuity));
+    dt295_routes *r = dt295_routes_create();
+    assert(r);
+    uint8_t b[TEST_SECTION_MAX];
+    size_t n = make_pat_av_and_data(b, 1);
+    feed_section(r, 0, b, n);
+    n = make_empty_cat(b, 0);
+    feed_section(r, 1, b, n);
+
+    dt295_route_plan live, full;
+    char error[DT295_ROUTE_ERROR];
+    assert(dt295_routes_initial_plan(r, &live, error) == 0);
+    n = make_pmt(b, 1, 1, 0x100, 0, 0);
+    feed_section(r, 0x100, b, n);
+    n = make_pmt_data_only_no_pcr(b, 1, 65520, 0x1300);
+    feed_section(r, 7408, b, n);
+
+    dt295_routes_snapshot snapshot;
+    dt295_routes_snapshot_get(r, &snapshot);
+    assert(snapshot.have_pat && snapshot.have_cat && snapshot.ready);
+    assert(snapshot.program_count == 2 && snapshot.missing_pmts == 0);
+    assert(dt295_routes_build(r, 0, NULL, &full, error) == 0);
+    assert(full.ready && full.has_primary && full.primary_program == 1);
+    assert(full.dedicated_pid[3] == 0x101); /* AV program keeps its valid PCR PID. */
+    int data_es_routed = 0;
+    for (unsigned i = 0; i < DT295_SLOT_COUNT; ++i) {
+        assert(!full.routes[i].enabled || full.routes[i].pid != 0x1fff);
+        if (full.routes[i].enabled && full.routes[i].pid == 0x1300)
+            data_es_routed = 1;
+    }
+    assert(data_es_routed);
+    dt295_routes_destroy(r);
+}
+
+static void test_guard_atomicity_and_no_rebind(void) {
+    dt295_route_plan live = {0}, candidate, before;
+    char error[DT295_ROUTE_ERROR];
+    live.routes[4] = (dt295_route){4, 1, 0, 0, 0, 0};
+    live.route_count = 1;
+    dt295_route_op good = {63, 1, 0x1ed, 63};
+    assert(dt295_routes_guard(&live, &good, 1, &candidate, error) == 0);
+    dt295_routes_commit(&live, &candidate);
+    dt295_route_op bad_batch[2] = {{62, 1, 0x101, 63}, {61, 1, 0x101, 0}};
+    before = live;
+    candidate = before;
+    assert(dt295_routes_guard(&live, bad_batch, 2, &candidate, error) != 0);
+    assert(memcmp(&candidate, &before, sizeof(before)) == 0);
+    dt295_route_op remove_ecm = {63, 0, 0x1ed, 63};
+    dt295_route_op dep = {5, 1, 0x101, 63};
+    assert(dt295_routes_guard(&live, &dep, 1, &candidate, error) == 0);
+    dt295_routes_commit(&live, &candidate);
+    before = live;
+    assert(dt295_routes_guard(&live, &remove_ecm, 1, &candidate, error) != 0);
+    assert(memcmp(&live, &before, sizeof(live)) == 0);
+    dt295_route_op second_ecm = {62, 1, 0x1ee, 62};
+    assert(dt295_routes_guard(&live, &second_ecm, 1, &candidate, error) == 0);
+    dt295_routes_commit(&live, &candidate);
+    dt295_route_op rebind = {5, 1, 0x101, 62};
+    assert(dt295_routes_guard(&live, &rebind, 1, &candidate, error) != 0);
+    dt295_route_op replace = {5, 1, 0x102, 63};
+    assert(dt295_routes_guard(&live, &replace, 1, &candidate, error) != 0);
+}
+
+static void test_bad_crc_same_version_and_capacity(void) {
+    memset(continuity, 0, sizeof(continuity));
+    dt295_routes *r = dt295_routes_create();
+    assert(r);
+    uint8_t b[TEST_SECTION_MAX];
+    size_t n = make_pat(b, 1, 0, 0, 1, 0x100);
+    b[n - 1] ^= 1;
+    feed_section(r, 0, b, n);
+    dt295_routes_snapshot s;
+    dt295_routes_snapshot_get(r, &s);
+    assert(!s.have_pat && s.invalid_sections);
+    b[n - 1] ^= 1;
+    feed_section(r, 0, b, n);
+    dt295_routes_snapshot_get(r, &s);
+    assert(s.have_pat);
+    uint32_t unsupported_before = s.unsupported_tables;
+    n = make_pat(b, 1, 0, 0, 2, 0x110);
+    feed_section(r, 0, b, n);
+    dt295_routes_snapshot_get(r, &s);
+    assert(s.program_count == 1 && s.programs[0].program == 1 && s.invalid_sections >= 2);
+    assert(s.unsupported_tables > unsupported_before);
+    dt295_route_plan base = {0}, desired;
+    base.routes[4] = (dt295_route){4, 1, 0, 0, 0, 0};
+    base.route_count = 1;
+    for (unsigned i = 5; i < 64; ++i) {
+        base.routes[i] = (dt295_route){(uint8_t)i, 1, 0, 0, (uint16_t)(100 + i), 0};
+        base.route_count++;
+    }
+    char error[DT295_ROUTE_ERROR];
+    assert(dt295_routes_build(r, 0, &base, &desired, error) !=
+           0); /* unresolved PMT/primary or no free capacity */
+    dt295_routes_destroy(r);
+
+    memset(continuity, 0, sizeof(continuity));
+    r = dt295_routes_create();
+    assert(r);
+    for (unsigned sn = 0; sn < 2; ++sn) {
+        uint8_t payload[128];
+        for (unsigned j = 0; j < 32; ++j) {
+            unsigned program = sn * 32 + j + 1, pid = 0x100 + program;
+            payload[j * 4] = (uint8_t)(program >> 8);
+            payload[j * 4 + 1] = (uint8_t)program;
+            payload[j * 4 + 2] = (uint8_t)(0xe0 | (pid >> 8));
+            payload[j * 4 + 3] = (uint8_t)pid;
+        }
+        n = make_table(b, 0, 0x4321, 2, sn, 1, payload, sizeof(payload));
+        feed_section(r, 0, b, n);
+    }
+    dt295_route_plan bootstrap_plan;
+    assert(dt295_routes_initial_plan(r, &bootstrap_plan, error) != 0);
+    assert(strstr(error, "capacity") != NULL);
+    dt295_routes_destroy(r);
+}
+
+int main(void) {
+    test_completeness_versions_and_planning();
+    test_stable_bootstrap_slots();
+    test_unsupported_multi_ecm_pmt_update_preserves_commit();
+    test_av_and_data_program_with_null_pcr();
+    test_guard_atomicity_and_no_rebind();
+    test_bad_crc_same_version_and_capacity();
+    puts("dt295 routes ok");
+    return 0;
+}
diff --git a/tests/test_dt295_stream.c b/tests/test_dt295_stream.c
new file mode 100644
index 0000000..6c841fb
--- /dev/null
+++ b/tests/test_dt295_stream.c
@@ -0,0 +1,97 @@
+#ifdef _WIN32
+#include <stdio.h>
+int main(void) {
+    puts("DT295 async stream: skipped (POSIX implementation only)");
+    return 0;
+}
+#else
+#include "dt295_stream.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static dt295_stream *make(unsigned blocks) {
+    dt295_stream *s = dt295_stream_test_create(blocks);
+    assert(s);
+    return s;
+}
+static void dispose(dt295_stream *s) {
+    dt295_stream_test_mark_stopped(s);
+    assert(dt295_stream_destroy(s) == 0);
+}
+static int complete(dt295_stream *s, unsigned slot, enum libusb_transfer_status status, int length,
+                    unsigned char value) {
+    return dt295_stream_test_complete(s, slot, status, length, value);
+}
+int main(void) {
+    unsigned char buffer[DT295_STREAM_TRANSFER_BYTES];
+    uint64_t seq = 0, when = 0;
+    dt295_stream_stats stats;
+
+    dt295_stream *s = make(8);
+    assert(!complete(s, 1, LIBUSB_TRANSFER_COMPLETED, 188, 0x22));
+    assert(dt295_stream_read(s, buffer, sizeof(buffer), &seq, &when, 0) == 0);
+    assert(!complete(s, 0, LIBUSB_TRANSFER_COMPLETED, 188, 0x11));
+    assert(dt295_stream_read(s, buffer, sizeof(buffer), &seq, &when, 0) == 188);
+    assert(seq == 0 && buffer[0] == 0x11 && when != 0);
+    assert(dt295_stream_read(s, buffer, sizeof(buffer), &seq, &when, 0) == 188);
+    assert(seq == 1 && buffer[0] == 0x22);
+    dt295_stream_snapshot(s, &stats);
+    assert(stats.delivered == 2 && stats.completed == 2 && stats.pending_blocks == 2);
+    dispose(s);
+
+    s = make(8);
+    assert(!complete(s, 0, LIBUSB_TRANSFER_TIMED_OUT, 17, 0x31));
+    assert(dt295_stream_read(s, buffer, sizeof(buffer), &seq, &when, 0) == 17);
+    assert(buffer[16] == 0x31);
+    dt295_stream_snapshot(s, &stats);
+    assert(stats.timeouts == 1 && stats.delivered_bytes == 17);
+    dispose(s);
+
+    s = make(8);
+    assert(!complete(s, 0, LIBUSB_TRANSFER_COMPLETED, 188, 0x44));
+    assert(!complete(s, 1, LIBUSB_TRANSFER_ERROR, 0, 0));
+    dt295_stream_snapshot(s, &stats);
+    int first = stats.first_error;
+    assert(first == LIBUSB_ERROR_IO);
+    assert(dt295_stream_read(s, buffer, sizeof(buffer), &seq, &when, 0) == 188);
+    assert(buffer[0] == 0x44);
+    assert(dt295_stream_read(s, buffer, sizeof(buffer), &seq, &when, 0) == first);
+    assert(!complete(s, 0, LIBUSB_TRANSFER_COMPLETED, 19, 0x55));
+    dt295_stream_snapshot(s, &stats);
+    assert(stats.first_error == first && stats.late_actual_bytes == 19 &&
+           stats.late_callbacks == 1);
+    dispose(s);
+
+    s = make(4);
+    assert(!complete(s, 0, LIBUSB_TRANSFER_COMPLETED, 1, 0x60));
+    assert(!complete(s, 1, LIBUSB_TRANSFER_COMPLETED, 1, 0x61));
+    assert(!complete(s, 0, LIBUSB_TRANSFER_COMPLETED, 1, 0x62));
+    dt295_stream_snapshot(s, &stats);
+    assert(stats.first_error == LIBUSB_ERROR_NO_MEM && stats.peak_pending_blocks == 4);
+    for (unsigned i = 0; i < 3; ++i) {
+        assert(dt295_stream_read(s, buffer, sizeof(buffer), &seq, &when, 0) == 1);
+        assert(seq == i && buffer[0] == (unsigned char)(0x60 + i));
+    }
+    dispose(s);
+
+    /* An unjoined event owner keeps transfer storage alive after stop deadlines. */
+    s = make(8);
+    assert(dt295_stream_destroy(s) == DT295_STREAM_ABANDONED);
+    assert(dt295_stream_stop(s, 0) == DT295_STREAM_ABANDONED);
+    assert(dt295_stream_stop(s, 2) == DT295_STREAM_ABANDONED);
+    assert(!complete(s, 0, LIBUSB_TRANSFER_COMPLETED, 37, 0x71));
+    dt295_stream_snapshot(s, &stats);
+    assert(stats.stopping && !stats.thread_done && stats.late_callbacks == 1 &&
+           stats.late_actual_bytes == 37);
+    assert(dt295_stream_destroy(s) == DT295_STREAM_ABANDONED);
+    dt295_stream_test_mark_stopped(s);
+    assert(dt295_stream_destroy(s) == 0);
+
+    puts("DT295 synthetic stream cases passed: order, partial timeout, error prefix, bounded ring, "
+         "first error, late-byte accounting, stop deadline ownership");
+    return 0;
+}
+#endif
diff --git a/tests/test_ts_output.c b/tests/test_ts_output.c
new file mode 100644
index 0000000..4e5fc5a
--- /dev/null
+++ b/tests/test_ts_output.c
@@ -0,0 +1,411 @@
+#ifdef _WIN32
+#include <stdio.h>
+int main(void) {
+    puts("DT295 output helper: skipped (POSIX implementation only)");
+    return 0;
+}
+#else
+#include "ts_output.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+static void temp_path(char path[64]) {
+    strcpy(path, "/tmp/pix-ts-output-XXXXXX");
+    int fd = mkstemp(path);
+    assert(fd >= 0);
+    close(fd);
+}
+static void parent_sigterm_handler(int signal_number) {
+    (void)signal_number;
+}
+static void verify_file(const char *path, const unsigned char *expected, size_t n) {
+    unsigned char *actual = malloc(n ? n : 1);
+    assert(actual);
+    int fd = open(path, O_RDONLY);
+    assert(fd >= 0);
+    size_t have = 0;
+    while (have < n) {
+        ssize_t r = read(fd, actual + have, n - have);
+        assert(r > 0);
+        have += (size_t)r;
+    }
+    unsigned char extra;
+    assert(read(fd, &extra, 1) == 0);
+    close(fd);
+    assert(!memcmp(actual, expected, n));
+    free(actual);
+}
+int main(void) {
+    unsigned char payload[4096];
+    for (size_t i = 0; i < sizeof(payload); ++i)
+        payload[i] = (unsigned char)(i * 29u);
+    char path[64];
+    ts_output *a = NULL, *b = NULL;
+    uint64_t id;
+    ts_output_stats stats;
+
+    /* Two independent children must not inherit each other's IPC endpoints. */
+    temp_path(path);
+    assert(ts_output_open(path, -1, NULL, &a) == 0);
+    char path2[64];
+    temp_path(path2);
+    assert(ts_output_open(path2, -1, NULL, &b) == 0);
+    assert(ts_output_submit(a, payload, sizeof(payload), &id) == 0 && id == 1);
+    assert(ts_output_submit(b, payload + 4, 3, NULL) == 0);
+    assert(ts_output_submit(b, payload + 17, 701, &id) == 0 && id == 2);
+    assert(ts_output_finish(a, 3000) == 0);
+    assert(ts_output_finish(b, 3000) == 0);
+    ts_output_snapshot(a, &stats);
+    assert(stats.finished && stats.confirmed_bytes == sizeof(payload) && !stats.pending_bytes);
+    verify_file(path, payload, sizeof(payload));
+    unsigned char expected_b[704];
+    memcpy(expected_b, payload + 4, 3);
+    memcpy(expected_b + 3, payload + 17, 701);
+    verify_file(path2, expected_b, sizeof(expected_b));
+    assert(ts_output_destroy(a) == 0 && ts_output_destroy(b) == 0);
+    unlink(path);
+    unlink(path2);
+
+    /* Capacity includes the job resident in the child and refuses overflow visibly. */
+    temp_path(path);
+    ts_output_config cfg = {0};
+    cfg.capacity_bytes = sizeof(payload);
+    assert(ts_output_open(path, -1, &cfg, &a) == 0);
+    assert(ts_output_submit(a, payload, sizeof(payload), &id) == 0);
+    assert(ts_output_submit(a, payload, 1, &id) == EAGAIN);
+    ts_output_snapshot(a, &stats);
+    assert(stats.submitted_bytes == sizeof(payload) + 1 && stats.rejected_bytes == 1 &&
+           stats.peak_pending_bytes == sizeof(payload));
+    assert(ts_output_finish(a, 3000) == 0);
+    verify_file(path, payload, sizeof(payload));
+    assert(ts_output_destroy(a) == 0);
+    unlink(path);
+
+    /* The child resets the caller's SIGTERM handler so abort can reap it promptly. */
+    temp_path(path);
+    void (*old_handler)(int) = signal(SIGTERM, parent_sigterm_handler);
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.test_stall_after_receive = 1;
+    assert(ts_output_open(path, -1, &cfg, &a) == 0);
+    assert(ts_output_submit(a, payload, 211, NULL) == 0);
+    for (unsigned i = 0; i < 100; ++i) {
+        (void)ts_output_poll(a, 2);
+        ts_output_snapshot(a, &stats);
+        struct timespec pause = {0, 2000000L};
+        nanosleep(&pause, NULL);
+    }
+    struct timespec abort_start, abort_end;
+    assert(clock_gettime(CLOCK_MONOTONIC, &abort_start) == 0);
+    assert(ts_output_abort(a, 500) == 0);
+    assert(clock_gettime(CLOCK_MONOTONIC, &abort_end) == 0);
+    int64_t abort_elapsed_ns = (int64_t)(abort_end.tv_sec - abort_start.tv_sec) * 1000000000LL +
+                               (int64_t)abort_end.tv_nsec - (int64_t)abort_start.tv_nsec;
+    assert(abort_elapsed_ns < 300000000LL);
+    ts_output_snapshot(a, &stats);
+    assert(stats.child_status != -1 && stats.pending_bytes == 0 && stats.uncertain_bytes == 211 &&
+           stats.confirmed_bytes == 0);
+    assert(ts_output_destroy(a) == 0);
+    unlink(path);
+    (void)signal(SIGTERM, old_handler);
+
+    /* Missing close acknowledgement fails at the drain deadline even with no pending payload. */
+    temp_path(path);
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.test_stall_close_ack = 1;
+    assert(ts_output_open(path, -1, &cfg, &a) == 0);
+    assert(ts_output_submit(a, payload, 29, NULL) == 0);
+    struct timespec start_time, end_time;
+    assert(clock_gettime(CLOCK_MONOTONIC, &start_time) == 0);
+    assert(ts_output_finish(a, 120) == ETIMEDOUT);
+    assert(clock_gettime(CLOCK_MONOTONIC, &end_time) == 0);
+    int64_t elapsed_ns = (int64_t)(end_time.tv_sec - start_time.tv_sec) * 1000000000LL +
+                         (int64_t)end_time.tv_nsec - (int64_t)start_time.tv_nsec;
+    assert(elapsed_ns >= 100000000LL && elapsed_ns < 1000000000LL);
+    ts_output_snapshot(a, &stats);
+    assert(stats.confirmed_bytes == 29 && stats.pending_bytes == 0 &&
+           stats.first_error == ETIMEDOUT);
+    assert(ts_output_abort(a, 500) == 0);
+    assert(ts_output_destroy(a) == 0);
+    unlink(path);
+
+    /* Simulated short writes followed by an error count only positive write returns. */
+    temp_path(path);
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.test_write_chunk_bytes = 7;
+    cfg.test_fail_after_bytes = 37;
+    assert(ts_output_open(path, -1, &cfg, &a) == 0);
+    assert(ts_output_submit(a, payload, 100, &id) == 0);
+    assert(ts_output_finish(a, 3000) == EIO);
+    ts_output_snapshot(a, &stats);
+    assert(stats.confirmed_bytes == 37 && stats.rejected_bytes == 63 && !stats.pending_bytes &&
+           stats.first_error == EIO);
+    verify_file(path, payload, 37);
+    assert(ts_output_destroy(a) == 0);
+    unlink(path);
+
+    /* Close errors keep successfully written bytes confirmed and fail completion. */
+    temp_path(path);
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.test_close_error = 1;
+    assert(ts_output_open(path, -1, &cfg, &a) == 0);
+    assert(ts_output_submit(a, payload, 73, &id) == 0);
+    assert(ts_output_finish(a, 3000) == EIO);
+    ts_output_snapshot(a, &stats);
+    assert(stats.confirmed_bytes == 73 && stats.rejected_bytes == 0 && stats.first_error == EIO);
+    verify_file(path, payload, 73);
+    assert(ts_output_destroy(a) == 0);
+    unlink(path);
+
+    /* A child exit after receiving a full frame leaves the write result unknown. */
+    temp_path(path);
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.test_crash_after_receive = 1;
+    assert(ts_output_open(path, -1, &cfg, &a) == 0);
+    assert(ts_output_submit(a, payload, 211, &id) == 0);
+    ts_output_snapshot(a, &stats);
+    assert(stats.child_pid > 0 && stats.child_status == -1);
+    int crash_rc = 0;
+    for (unsigned i = 0; i < 500 && !crash_rc; ++i)
+        crash_rc = ts_output_poll(a, 5);
+    assert(crash_rc == EPIPE);
+    assert(ts_output_abort(a, 1000) == 0);
+    ts_output_snapshot(a, &stats);
+    assert(stats.pending_bytes == 0 && stats.uncertain_bytes == 211 && stats.confirmed_bytes == 0 &&
+           stats.rejected_bytes == 0);
+    assert(ts_output_destroy(a) == 0);
+    unlink(path);
+
+    /* A blocked pipe is bounded by its shorter stall deadline and remains uncertain. */
+    int pipefd[2];
+    assert(pipe(pipefd) == 0);
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.capacity_bytes = 1024 * 1024;
+    cfg.pipe_stall_ms = 100;
+    assert(ts_output_open("-", pipefd[1], &cfg, &a) == 0);
+    close(pipefd[1]);
+    unsigned char *large = malloc(512 * 1024);
+    assert(large);
+    memset(large, 0x7a, 512 * 1024);
+    assert(ts_output_submit(a, large, 512 * 1024, &id) == 0);
+    int poll_rc = 0;
+    for (unsigned i = 0; i < 500 && !poll_rc; ++i)
+        poll_rc = ts_output_poll(a, 5);
+    assert(poll_rc == ETIMEDOUT);
+    (void)ts_output_abort(a, 300);
+    ts_output_snapshot(a, &stats);
+    assert(stats.stalled && stats.first_error == ETIMEDOUT &&
+           stats.pending_bytes + stats.confirmed_bytes + stats.rejected_bytes +
+                   stats.uncertain_bytes ==
+               stats.submitted_bytes);
+    assert(ts_output_destroy(a) == 0);
+    close(pipefd[0]);
+    free(large);
+
+    /* Writer timing is measured independently from parent polling. */
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.test_write_delay_ms = 40;
+    int telemetry_fd = open("/dev/null", O_WRONLY);
+    assert(telemetry_fd >= 0);
+    assert(ts_output_open("-", telemetry_fd, &cfg, &a) == 0);
+    close(telemetry_fd);
+    assert(ts_output_submit(a, payload, sizeof(payload), NULL) == 0);
+    assert(ts_output_finish(a, 3000) == 0);
+    ts_output_snapshot(a, &stats);
+    assert(stats.writer_write_records == 1 && stats.writer_write_ns_total >= 30000000ULL &&
+           stats.writer_write_ns_max >= 30000000ULL && stats.max_pending_age_ns >= 30000000ULL);
+    assert(ts_output_destroy(a) == 0);
+
+    /* A deliberate delay in parent servicing is visible even when the child
+       writer itself is quick. */
+    memset(&cfg, 0, sizeof(cfg));
+    telemetry_fd = open("/dev/null", O_WRONLY);
+    assert(telemetry_fd >= 0);
+    assert(ts_output_open("-", telemetry_fd, &cfg, &a) == 0);
+    close(telemetry_fd);
+    assert(ts_output_submit(a, payload, sizeof(payload), NULL) == 0);
+    struct timespec parent_service_pause = {0, 80000000L};
+    nanosleep(&parent_service_pause, NULL);
+    assert(ts_output_poll(a, 0) == 0);
+    assert(ts_output_finish(a, 3000) == 0);
+    ts_output_snapshot(a, &stats);
+    assert(stats.max_parent_poll_gap_ns >= 60000000ULL &&
+           stats.max_pending_age_ns >= stats.max_parent_poll_gap_ns &&
+           stats.writer_write_ns_max < stats.max_parent_poll_gap_ns);
+    assert(ts_output_destroy(a) == 0);
+
+    /* A receive-like producer polls once per 64 KiB tick. poll(0) must drain
+       ready frame/ACK work instead of accumulating one record per tick. */
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.capacity_bytes = 16 * 1024 * 1024;
+    int paced_fd = open("/dev/null", O_WRONLY);
+    assert(paced_fd >= 0);
+    assert(ts_output_open("-", paced_fd, &cfg, &a) == 0);
+    close(paced_fd);
+    unsigned char *paced = malloc(64 * 1024);
+    assert(paced);
+    memset(paced, 0x4d, 64 * 1024);
+    const unsigned paced_ticks = 160;
+    uint64_t paced_peak = 0;
+    for (unsigned tick = 0; tick < paced_ticks; ++tick) {
+        assert(ts_output_poll(a, 0) == 0);
+        assert(ts_output_submit(a, paced, 64 * 1024, NULL) == 0);
+        ts_output_snapshot(a, &stats);
+        if (stats.peak_pending_bytes > paced_peak)
+            paced_peak = stats.peak_pending_bytes;
+        struct timespec pace = {0, 5000000L};
+        nanosleep(&pace, NULL);
+    }
+    assert(ts_output_finish(a, 10000) == 0);
+    ts_output_snapshot(a, &stats);
+    assert(stats.confirmed_bytes == (uint64_t)paced_ticks * 64 * 1024 &&
+           !stats.pending_bytes);
+    assert(paced_peak < 8 * 64 * 1024);
+    assert(ts_output_destroy(a) == 0);
+
+    /* Receive callbacks arrive in short bursts with variable gaps. The writer
+       gets an idle interval after each burst; output must recover to zero
+       pending rather than carry a residual queue into the next interval. */
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.capacity_bytes = 16 * 1024 * 1024;
+    paced_fd = open("/dev/null", O_WRONLY);
+    assert(paced_fd >= 0);
+    assert(ts_output_open("-", paced_fd, &cfg, &a) == 0);
+    close(paced_fd);
+    const unsigned burst_count = 16;
+    const unsigned records_per_burst = 8;
+    uint64_t burst_peak = 0;
+    for (unsigned burst = 0; burst < burst_count; ++burst) {
+        for (unsigned tick = 0; tick < records_per_burst; ++tick) {
+            assert(ts_output_poll(a, 0) == 0);
+            assert(ts_output_submit(a, paced, 64 * 1024, NULL) == 0);
+            ts_output_snapshot(a, &stats);
+            if (stats.peak_pending_bytes > burst_peak)
+                burst_peak = stats.peak_pending_bytes;
+            if ((burst + tick) % 3 == 0) {
+                struct timespec variable_gap = {0, 500000L};
+                nanosleep(&variable_gap, NULL);
+            }
+        }
+        struct timespec idle_gap = {0, 25000000L};
+        nanosleep(&idle_gap, NULL);
+        for (unsigned drain = 0; drain < 200; ++drain) {
+            assert(ts_output_poll(a, 0) == 0);
+            ts_output_snapshot(a, &stats);
+            if (!stats.pending_bytes)
+                break;
+            struct timespec yield = {0, 500000L};
+            nanosleep(&yield, NULL);
+        }
+        assert(stats.pending_bytes == 0);
+    }
+    assert(burst_peak < 2 * records_per_burst * 64 * 1024);
+    assert(ts_output_finish(a, 5000) == 0);
+    ts_output_snapshot(a, &stats);
+    assert(stats.confirmed_bytes ==
+               (uint64_t)burst_count * records_per_burst * 64 * 1024 &&
+           !stats.pending_bytes);
+    assert(ts_output_destroy(a) == 0);
+    free(paced);
+
+    /* The isolated child deliberately retains FIFO ACKs until eight records
+       have been written. A sender with only one outstanding record deadlocks;
+       the byte-window pipeline fills the child and then validates all ACKs. */
+    temp_path(path);
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.capacity_bytes = 1024 * 1024;
+    cfg.test_ack_batch_records = 8;
+    assert(ts_output_open(path, -1, &cfg, &a) == 0);
+    size_t lengths[8], expected_length = 0;
+    unsigned char *records[8];
+    for (unsigned i = 0; i < 8; ++i) {
+        lengths[i] = 4096 + i * 509;
+        records[i] = malloc(lengths[i]);
+        assert(records[i]);
+        memset(records[i], (int)(0x30 + i), lengths[i]);
+        expected_length += lengths[i];
+    }
+    unsigned char *expected = malloc(expected_length);
+    assert(expected);
+    size_t expected_offset = 0;
+    uint64_t batch_peak = 0;
+    for (unsigned i = 0; i < 8; ++i) {
+        assert(ts_output_poll(a, 0) == 0);
+        assert(ts_output_submit(a, records[i], lengths[i], NULL) == 0);
+        memcpy(expected + expected_offset, records[i], lengths[i]);
+        expected_offset += lengths[i];
+        ts_output_snapshot(a, &stats);
+        if (stats.peak_pending_bytes > batch_peak)
+            batch_peak = stats.peak_pending_bytes;
+    }
+    assert(ts_output_finish(a, 5000) == 0);
+    ts_output_snapshot(a, &stats);
+    assert(stats.completed_records == 8 && stats.confirmed_bytes == expected_length &&
+           !stats.pending_bytes && batch_peak == expected_length);
+    verify_file(path, expected, expected_length);
+    assert(ts_output_destroy(a) == 0);
+    unlink(path);
+    free(expected);
+    for (unsigned i = 0; i < 8; ++i)
+        free(records[i]);
+
+    /* A record larger than the in-flight byte window is admitted when it is
+       the only record in flight, then drains without window deadlock. */
+    temp_path(path);
+    memset(&cfg, 0, sizeof(cfg));
+    assert(ts_output_open(path, -1, &cfg, &a) == 0);
+    size_t oversized_length = 2 * 1024 * 1024;
+    unsigned char *oversized = malloc(oversized_length);
+    assert(oversized);
+    memset(oversized, 0xa7, oversized_length);
+    assert(ts_output_submit(a, oversized, oversized_length, NULL) == 0);
+    assert(ts_output_finish(a, 10000) == 0);
+    ts_output_snapshot(a, &stats);
+    assert(stats.completed_records == 1 && stats.confirmed_bytes == oversized_length &&
+           !stats.pending_bytes);
+    verify_file(path, oversized, oversized_length);
+    assert(ts_output_destroy(a) == 0);
+    unlink(path);
+    free(oversized);
+
+    /* If the child stops after receiving one oversized record, that completely
+       sent record is uncertain on abort; later records blocked by the byte
+       window are known never sent and therefore rejected. */
+    temp_path(path);
+    memset(&cfg, 0, sizeof(cfg));
+    cfg.capacity_bytes = 8 * 1024 * 1024;
+    cfg.test_stall_after_receive = 1;
+    assert(ts_output_open(path, -1, &cfg, &a) == 0);
+    size_t stalled_record_length = 2 * 1024 * 1024;
+    unsigned char *stalled_record = malloc(stalled_record_length);
+    assert(stalled_record);
+    memset(stalled_record, 0x62, stalled_record_length);
+    for (unsigned i = 0; i < 3; ++i)
+        assert(ts_output_submit(a, stalled_record, stalled_record_length, NULL) == 0);
+    for (unsigned i = 0; i < 20; ++i)
+        (void)ts_output_poll(a, 10);
+    assert(ts_output_abort(a, 500) == 0);
+    ts_output_snapshot(a, &stats);
+    assert(stats.uncertain_bytes == stalled_record_length &&
+           stats.rejected_bytes == 2 * stalled_record_length && !stats.pending_bytes &&
+           stats.submitted_bytes == stats.confirmed_bytes + stats.rejected_bytes +
+                                        stats.uncertain_bytes);
+    assert(ts_output_destroy(a) == 0);
+    unlink(path);
+    free(stalled_record);
+
+    puts("TS output synthetic process tests passed: independent helpers, optional ids, bounded "
+         "queue, short writes, partial failure, close error/ACK stall, child crash, stalled pipe, "
+         "writer and parent-service telemetry, paced and burst zero-time polling, bounded FIFO "
+         "ACK pipeline");
+    return 0;
+}
+#endif
diff --git a/tools/prepare-dt295-assets.py b/tools/prepare-dt295-assets.py
new file mode 100644
index 0000000..e418093
--- /dev/null
+++ b/tools/prepare-dt295-assets.py
@@ -0,0 +1,179 @@
+#!/usr/bin/env python3
+"""Build a private, integrity-checked DT295 runtime bundle from user files."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import struct
+import tempfile
+
+DRIVER_SHA256 = "46889d2f8b046485a0cc25451c1691ca87b13601d0566c807ee6e1c9084fc878"
+MAT_BASE = 0x841D0
+MAT_END = 0x85450
+IMAGE_LIMIT = 16 * 1024 * 1024
+FIELD_LIMIT = 4096
+
+
+def u16(value):
+    return struct.pack("<H", value)
+
+
+def extract_driver_material(path):
+    raw = Path(path).read_bytes()
+    if hashlib.sha256(raw).hexdigest() != DRIVER_SHA256:
+        raise ValueError("unsupported official driver SHA-256")
+    if len(raw) < 0x40 or raw[:2] != b"MZ":
+        raise ValueError("driver is not a PE image")
+    pe = struct.unpack_from("<I", raw, 0x3C)[0]
+    if pe + 24 > len(raw) or raw[pe:pe + 4] != b"PE\0\0":
+        raise ValueError("invalid PE header")
+    sections = struct.unpack_from("<H", raw, pe + 6)[0]
+    optional_size = struct.unpack_from("<H", raw, pe + 20)[0]
+    optional = pe + 24
+    if optional + optional_size + sections * 40 > len(raw) or optional_size < 32:
+        raise ValueError("truncated PE section table")
+    magic = struct.unpack_from("<H", raw, optional)[0]
+    if magic != 0x20B:
+        raise ValueError("official driver must be PE32+")
+    image_base = struct.unpack_from("<Q", raw, optional + 24)[0]
+    section_rows = []
+    for i in range(sections):
+        off = optional + optional_size + 40 * i
+        virtual_size, rva, raw_size, raw_pos = struct.unpack_from("<4I", raw, off + 8)
+        section_rows.append((rva, max(virtual_size, raw_size), raw_size, raw_pos))
+
+    def read_va(va, size):
+        rva = va - image_base
+        for start, virtual_size, raw_size, raw_pos in section_rows:
+            delta = rva - start
+            if 0 <= delta and delta + size <= min(virtual_size, raw_size):
+                pos = raw_pos + delta
+                if pos + size <= len(raw):
+                    return raw[pos:pos + size]
+        raise ValueError(f"required material at VA {va:x} is outside driver sections")
+
+    material = bytearray(MAT_END - MAT_BASE)
+    spans = ((0x841D0, 22 * 8), (0x84630, 26 * 8), (0x84700, 28 * 8),
+             (0x85148, 30), (0x85168, 12), (0x85178, 28),
+             (0x85198, 16), (0x851A8, 16), (0x851B8, 16), (0x851C8, 16),
+             (0x851D8, 16), (0x851E8, 16), (0x851F8, 16), (0x85208, 16),
+             (0x85218, 16), (0x85230, 16 * 32))
+    for va, size in spans:
+        off = va - MAT_BASE
+        material[off:off + size] = read_va(va, size)
+    return bytes(material)
+
+
+def parse_profile(path):
+    profile = json.loads(Path(path).read_text(encoding="utf-8"))
+    if not isinstance(profile, dict):
+        raise ValueError("profile must be a JSON object")
+    if type(profile.get("schema")) is not int or profile.get("schema") != 1 or type(profile.get("target")) is not int or profile.get("target") != 0:
+        raise ValueError("profile must have schema 1 and target 0")
+    words = profile.get("ts_key_request_words")
+    if not isinstance(words, list) or len(words) != 3 or any(type(x) is not int or not 0 <= x <= 0xFFFFFFFF for x in words):
+        raise ValueError("ts_key_request_words must contain three uint32 values")
+    rows = profile.get("fields")
+    if not isinstance(rows, list) or not rows or len(rows) > FIELD_LIMIT:
+        raise ValueError("invalid TRC field list")
+    fields = []
+    normalized = {
+        "INIT_S_AUTO_PID_MODE": 0,
+        "INIT_S_PAYLOAD_UNIT_START_DISABLE_MODE": 1,
+    }
+    seen_normalized = set()
+    route_prefixes = ("INIT_S_V_PID_", "INIT_S_A_PID_", "INIT_S_PMT_PID_", "INIT_S_PCR_PID_",
+                      "INIT_S_PID_", "INIT_S_ECM_")
+    for row in rows:
+        if not isinstance(row, dict):
+            raise ValueError("TRC fields must be objects")
+        name = row.get("name", "")
+        if not isinstance(name, str):
+            raise ValueError("TRC field name must be a string")
+        if name in ("INIT_S_PROGRAM_NUMBER", "INIT_S_V_STREAM_TYPE", "INIT_S_A_STREAM_TYPE",
+                    "INIT_S_V_ECM", "INIT_S_A_ECM") or name.startswith(route_prefixes):
+            continue
+        a, shift, width, value = (row.get(k) for k in ("address", "shift", "width", "value"))
+        if name in normalized:
+            if name in seen_normalized:
+                raise ValueError(f"profile contains duplicate {name}")
+            seen_normalized.add(name)
+            value = normalized[name]
+        if any(type(v) is not int for v in (a, shift, width, value)):
+            raise ValueError("TRC field values must be integers")
+        if not 0x1000 <= a <= 0x1AFE or a & 1:
+            raise ValueError("TRC field outside configuration registers")
+        if not 0 <= shift < 16 or not 1 <= width <= 16 - shift or not 0 <= value < (1 << width):
+            raise ValueError("TRC field bit range is invalid")
+        fields.append(u16(a) + bytes((shift, width)) + u16(value) + b"\0\0")
+    if seen_normalized != set(normalized):
+        missing = sorted(set(normalized) - seen_normalized)
+        raise ValueError("profile missing required normalized field(s): " + ", ".join(missing))
+    if not fields:
+        raise ValueError("profile has no route-independent TRC fields")
+    return b"".join(fields), struct.pack(">3I", *words)
+
+
+def section(data):
+    return struct.pack("<I", len(data)) + hashlib.sha256(data).digest() + data
+
+
+def build_bundle(idle, trc, material, fields, key_request, ts_iv):
+    if not idle or len(idle) > IMAGE_LIMIT or not trc or len(trc) > IMAGE_LIMIT:
+        raise ValueError("idle and TRC images must be 1..16 MiB")
+    if len(material) != MAT_END - MAT_BASE:
+        raise ValueError("driver material has an invalid size")
+    if not fields or len(fields) % 8 or len(fields) > FIELD_LIMIT * 8:
+        raise ValueError("TRC fields have an invalid size")
+    if len(key_request) != 12 or len(ts_iv) != 16:
+        raise ValueError("key request must be 12 bytes and TS IV must be 16 bytes")
+    sections = [idle, trc, material, fields, key_request, ts_iv]
+    bundle = b"D295A1\0\0" + b"".join(
+        struct.pack("<I", len(data)) + hashlib.sha256(data).digest() for data in sections)
+    return bundle + b"".join(sections)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--driver", required=True, help="official pxmb86m0x_usb.sys")
+    ap.add_argument("--idle", required=True, help="official idle firmware image")
+    ap.add_argument("--trc", required=True, help="official terrestrial TRC image")
+    ap.add_argument("--profile", required=True, help="private target-0 profile JSON")
+    ap.add_argument("--iv", required=True, help="16-byte IV extracted from the official application")
+    ap.add_argument("--output", required=True, help="private bundle output, usually assets/dt295.assets")
+    args = ap.parse_args()
+    idle = Path(args.idle).read_bytes()
+    trc = Path(args.trc).read_bytes()
+    iv = Path(args.iv).read_bytes()
+    if not 0 < len(idle) <= IMAGE_LIMIT or not 0 < len(trc) <= IMAGE_LIMIT:
+        raise ValueError("idle and TRC images must be 1..16 MiB")
+    if len(iv) != 16:
+        raise ValueError("IV must contain exactly 16 bytes")
+    material = extract_driver_material(args.driver)
+    fields, key_request = parse_profile(args.profile)
+    bundle = build_bundle(idle, trc, material, fields, key_request, iv)
+    dest = Path(args.output)
+    dest.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+    fd, temp_name = tempfile.mkstemp(prefix=".dt295-assets-", dir=dest.parent)
+    try:
+        os.fchmod(fd, 0o600)
+        with os.fdopen(fd, "wb") as f:
+            f.write(bundle)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(temp_name, dest)
+        os.chmod(dest, 0o600)
+    except Exception:
+        try:
+            os.unlink(temp_name)
+        except OSError:
+            pass
+        raise
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (OSError, ValueError, json.JSONDecodeError, struct.error) as exc:
+        raise SystemExit(f"prepare-dt295-assets: {exc}")
