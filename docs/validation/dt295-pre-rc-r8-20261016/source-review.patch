+#include <sys/resource.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+#ifndef O_BINARY
+#define O_BINARY 0
+#endif
+
+#define TS_CHILD_END UINT64_MAX
+#define TS_OUTPUT_IPC_WINDOW_BYTES (1024U * 1024U)
+struct ts_frame {
+    uint64_t id;
+    uint64_t length;
+};
+struct ts_ack {
+    uint64_t id;
+    uint64_t written;
+    int32_t error;
+    int32_t close_error;
+    uint64_t writer_write_ns;
+};
+struct ts_job {
+    struct ts_job *next;
+    uint64_t id;
+    size_t length, sent;
+    uint64_t submitted_ns;
+    int ipc_complete;
+    unsigned char *data;
+};
+struct ts_output {
+    pid_t child;
+    int socket_fd, pipe_output;
+    struct ts_job *head, *tail, *current;
+    struct ts_frame frame;
+    size_t frame_sent;
+    unsigned char ack_buffer[sizeof(struct ts_ack)];
+    size_t ack_have;
+    size_t queued, ipc_inflight_bytes;
+    size_t capacity;
+    uint64_t next_id, last_progress_ns, idle_since_ns, last_pending_poll_ns, last_ack_ns;
+    unsigned warn_ms, file_stall_ms, pipe_stall_ms, drain_ms;
+    int first_error, accepting, ending, end_sent, ended, reaped, child_status;
+    int protocol_failed;
+    size_t test_write_chunk;
+    uint64_t test_fail_after;
+    int test_close_error;
+    ts_output_stats stats;
+};
+
+static uint64_t mono_ns(void) {
+    struct timespec t;
+    if (clock_gettime(CLOCK_MONOTONIC, &t))
+        return 0;
+    return (uint64_t)t.tv_sec * 1000000000ULL + (uint64_t)t.tv_nsec;
+}
+static void add_counter(uint64_t *counter, uint64_t amount) {
+    if (UINT64_MAX - *counter < amount)
+        *counter = UINT64_MAX;
+    else
+        *counter += amount;
+}
+static void remember_error(ts_output *o, int error) {
+    if (!o->first_error)
+        o->first_error = error ? error : EIO;
+    o->stats.first_error = o->first_error;
+    o->stats.child_pid = (int64_t)o->child;
+}
+static int set_nonblock(int fd) {
+    int flags = fcntl(fd, F_GETFL);
+    if (flags < 0 || fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0)
+        return -1;
+    return 0;
+}
+static int write_full(int fd, const void *data, size_t length) {
+    const unsigned char *p = data;
+    while (length) {
+        ssize_t n = write(fd, p, length);
+        if (n > 0) {
+            p += (size_t)n;
+            length -= (size_t)n;
+            continue;
+        }
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            struct pollfd f = {fd, POLLOUT, 0};
+            int r;
+            do {
+                r = poll(&f, 1, -1);
+            } while (r < 0 && errno == EINTR);
+            if (r > 0)
+                continue;
+        }
+        return errno ? errno : EIO;
+    }
+    return 0;
+}
+static int read_full(int fd, void *data, size_t length) {
+    unsigned char *p = data;
+    while (length) {
+        ssize_t n = read(fd, p, length);
+        if (n > 0) {
+            p += (size_t)n;
+            length -= (size_t)n;
+            continue;
+        }
+        if (n < 0 && errno == EINTR)
+            continue;
+        return n == 0 ? EPIPE : (errno ? errno : EIO);
+    }
+    return 0;
+}
+static void child_loop(int channel, int output_fd, int is_pipe, int max_fd, size_t test_chunk,
+                       uint64_t test_fail_after, int test_close_error, int test_crash_after_receive,
+                       int test_stall_close_ack, int test_stall_after_receive,
+                       unsigned test_ack_batch_records, unsigned test_write_delay_ms) {
+    (void)signal(SIGPIPE, SIG_IGN);
+    (void)signal(SIGTERM, SIG_DFL);
+    (void)signal(SIGINT, SIG_IGN);
+    for (int fd = 3; fd < max_fd; ++fd)
+        if (fd != channel && fd != output_fd)
+            (void)close(fd);
+    uint64_t total_written = 0;
+    struct ts_ack pending_acks[64];
+    unsigned pending_ack_count = 0;
+    if (test_ack_batch_records > 64)
+        test_ack_batch_records = 64;
+    for (;;) {
+        struct ts_frame frame;
+        int e = read_full(channel, &frame, sizeof(frame));
+        if (e)
+            _exit(80);
+        if (frame.id == TS_CHILD_END) {
+            for (unsigned i = 0; i < pending_ack_count; ++i)
+                if (write_full(channel, &pending_acks[i], sizeof(pending_acks[i])))
+                    _exit(84);
+            int close_error = close(output_fd) ? errno : 0;
+            if (!close_error && test_close_error)
+                close_error = EIO;
+            if (test_stall_close_ack) {
+                for (;;) {
+                    struct timespec pause = {3600, 0};
+                    nanosleep(&pause, NULL);
+                }
+            }
+            struct ts_ack ack = {TS_CHILD_END, 0, 0, close_error, 0};
+            (void)write_full(channel, &ack, sizeof(ack));
+            close(channel);
+            _exit(close_error ? 3 : 0);
+        }
+        if (!frame.length || frame.length > TS_OUTPUT_CAPACITY_BYTES)
+            _exit(81);
+        size_t length = (size_t)frame.length;
+        unsigned char *buffer = malloc(length);
+        if (!buffer)
+            _exit(82);
+        e = read_full(channel, buffer, length);
+        if (e) {
+            free(buffer);
+            _exit(83);
+        }
+        if (test_crash_after_receive)
+            _exit(86);
+        if (test_stall_after_receive) {
+            for (;;) {
+                struct timespec pause = {3600, 0};
+                nanosleep(&pause, NULL);
+            }
+        }
+        uint64_t write_start_ns = mono_ns();
+        if (test_write_delay_ms) {
+            struct timespec delay = {(time_t)(test_write_delay_ms / 1000),
+                                     (long)(test_write_delay_ms % 1000) * 1000000L};
+            while (nanosleep(&delay, &delay) && errno == EINTR) {
+            }
+        }
+        size_t off = 0;
+        int write_error = 0;
+        while (off < length) {
+            size_t amount = length - off;
+            if (is_pipe && amount > 4096)
+                amount = 4096;
+            if (test_chunk && amount > test_chunk)
+                amount = test_chunk;
+            if (test_fail_after && total_written >= test_fail_after) {
+                write_error = EIO;
+                break;
+            }
+            if (test_fail_after && amount > test_fail_after - total_written)
+                amount = (size_t)(test_fail_after - total_written);
+            if (!amount) {
+                write_error = EIO;
+                break;
+            }
+            ssize_t n = write(output_fd, buffer + off, amount);
+            if (n > 0) {
+                off += (size_t)n;
+                total_written += (uint64_t)n;
+                continue;
+            }
+            if (n < 0 && errno == EINTR)
+                continue;
+            if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+                struct pollfd f = {output_fd, POLLOUT, 0};
+                int r;
+                do {
+                    r = poll(&f, 1, -1);
+                } while (r < 0 && errno == EINTR);
+                if (r > 0)
+                    continue;
+            }
+            write_error = errno ? errno : EIO;
+            break;
+        }
+        free(buffer);
+        uint64_t write_duration_ns = mono_ns() - write_start_ns;
+        struct ts_ack ack = {frame.id, off, write_error, 0, write_duration_ns};
+        if (test_ack_batch_records) {
+            pending_acks[pending_ack_count++] = ack;
+            if (pending_ack_count >= test_ack_batch_records) {
+                for (unsigned i = 0; i < pending_ack_count; ++i)
+                    if (write_full(channel, &pending_acks[i], sizeof(pending_acks[i])))
+                        _exit(84);
+                pending_ack_count = 0;
+            }
+        } else {
+            e = write_full(channel, &ack, sizeof(ack));
+            if (e)
+                _exit(84);
+        }
+        if (write_error) {
+            (void)close(output_fd);
+            close(channel);
+            _exit(4);
+        }
+    }
+}
+static void classify_unresolved(ts_output *o) {
+    for (struct ts_job *j = o->head; j; j = j->next) {
+        if (j->ipc_complete)
+            o->stats.uncertain_bytes += j->length;
+        else
+            o->stats.rejected_bytes += j->length;
+    }
+    o->stats.pending_bytes = 0;
+    o->queued = 0;
+    o->last_pending_poll_ns = 0;
+    struct ts_job *j = o->head;
+    while (j) {
+        struct ts_job *next = j->next;
+        free(j->data);
+        free(j);
+        j = next;
+    }
+    o->head = o->tail = o->current = NULL;
+}
+static void observe_child(ts_output *o) {
+    if (o->reaped || o->child <= 0)
+        return;
+    int status = 0;
+    pid_t r = waitpid(o->child, &status, WNOHANG);
+    if (r == o->child) {
+        o->reaped = 1;
+        o->child_status = status;
+        o->stats.child_status = status;
+        if (!o->ended) {
+            remember_error(o, EPIPE);
+            classify_unresolved(o);
+        } else if (!WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+            remember_error(o, EIO);
+        }
+    } else if (r < 0 && errno != EINTR) {
+        remember_error(o, errno);
+    }
+}
+static void remove_head(ts_output *o) {
+    struct ts_job *j = o->head;
+    if (!j)
+        return;
+    o->head = j->next;
+    if (!o->head)
+        o->tail = NULL;
+    if (j->ipc_complete) {
+        if (o->ipc_inflight_bytes >= j->length)
+            o->ipc_inflight_bytes -= j->length;
+        else
+            o->ipc_inflight_bytes = 0;
+    }
+    o->queued -= j->length;
+    free(j->data);
+    free(j);
+}
+static int pump_send(ts_output *o) {
+    if (o->reaped || o->first_error)
+        return 0;
+    if (!o->current) {
+        struct ts_job *j = o->head;
+        while (j && j->ipc_complete)
+            j = j->next;
+        if (j) {
+            /* Permit one oversized record when the window is empty. */
+            if (o->ipc_inflight_bytes &&
+                (o->ipc_inflight_bytes >= TS_OUTPUT_IPC_WINDOW_BYTES ||
+                 j->length > TS_OUTPUT_IPC_WINDOW_BYTES - o->ipc_inflight_bytes))
+                return 0;
+            o->current = j;
+            o->frame.id = o->current->id;
+            o->frame.length = o->current->length;
+            o->frame_sent = 0;
+            o->current->sent = 0;
+        }
+    }
+    if (o->current) {
+        if (o->frame_sent < sizeof(o->frame)) {
+            const unsigned char *p = (const unsigned char *)&o->frame + o->frame_sent;
+            ssize_t n = send(o->socket_fd, p, sizeof(o->frame) - o->frame_sent, MSG_NOSIGNAL);
+            if (n > 0) {
+                o->frame_sent += (size_t)n;
+                return 1;
+            }
+            if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+                if (errno == EAGAIN || errno == EWOULDBLOCK)
+                    add_counter(&o->stats.send_eagain_count, 1);
+                return 0;
+            }
+            remember_error(o, errno ? errno : EPIPE);
+            return -1;
+        }
+        if (o->current->sent < o->current->length) {
+            ssize_t n = send(o->socket_fd, o->current->data + o->current->sent,
+                             o->current->length - o->current->sent, MSG_NOSIGNAL);
+            if (n > 0) {
+                o->current->sent += (size_t)n;
+                if (o->current->sent == o->current->length) {
+                    o->current->ipc_complete = 1;
+                    o->ipc_inflight_bytes += o->current->length;
+                    o->current = NULL;
+                    o->frame_sent = 0;
+                }
+                return 1;
+            }
+            if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+                if (errno == EAGAIN || errno == EWOULDBLOCK)
+                    add_counter(&o->stats.send_eagain_count, 1);
+                return 0;
+            }
+            remember_error(o, errno ? errno : EPIPE);
+            return -1;
+        }
+    } else if (o->ending && !o->end_sent && !o->head) {
+        struct ts_frame end = {TS_CHILD_END, 0};
+        ssize_t n = send(o->socket_fd, (const unsigned char *)&end, sizeof(end), MSG_NOSIGNAL);
+        if (n == (ssize_t)sizeof(end)) {
+            o->end_sent = 1;
+            o->last_progress_ns = mono_ns();
+            return 1;
+        }
+        if (n > 0) { /* small atomic frame; continue through the general path next poll */
+            o->frame = end;
+            o->frame_sent = (size_t)n;
+            o->end_sent = -1;
+            return 1;
+        }
+        if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+            if (errno == EAGAIN || errno == EWOULDBLOCK)
+                add_counter(&o->stats.send_eagain_count, 1);
+            return 0;
+        }
+        remember_error(o, errno ? errno : EPIPE);
+        return -1;
+    } else if (o->ending && o->end_sent == -1) {
+        ssize_t n = send(o->socket_fd, (const unsigned char *)&o->frame + o->frame_sent,
+                         sizeof(o->frame) - o->frame_sent, MSG_NOSIGNAL);
+        if (n > 0) {
+            o->frame_sent += (size_t)n;
+            if (o->frame_sent == sizeof(o->frame))
+                o->end_sent = 1;
+            return 1;
+        }
+        if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+            if (errno == EAGAIN || errno == EWOULDBLOCK)
+                add_counter(&o->stats.send_eagain_count, 1);
+            return 0;
+        }
+        remember_error(o, errno ? errno : EPIPE);
+        return -1;
+    }
+    return 0;
+}
+static int pump_ack(ts_output *o) {
+    ssize_t n =
+        recv(o->socket_fd, o->ack_buffer + o->ack_have, sizeof(struct ts_ack) - o->ack_have, 0);
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+        if (errno == EAGAIN || errno == EWOULDBLOCK)
+            add_counter(&o->stats.ack_eagain_count, 1);
+        return 0;
+    }
+    if (n == 0) {
+        observe_child(o);
+        if (!o->reaped)
+            remember_error(o, EPIPE);
+        return -1;
+    }
+    if (n < 0) {
+        remember_error(o, errno ? errno : EIO);
+        return -1;
+    }
+    o->ack_have += (size_t)n;
+    if (o->ack_have != sizeof(struct ts_ack))
+        return 1;
+    struct ts_ack ack;
+    memcpy(&ack, o->ack_buffer, sizeof(ack));
+    o->ack_have = 0;
+    o->last_progress_ns = mono_ns();
+    o->stats.last_progress_ns = o->last_progress_ns;
+    if (ack.id == TS_CHILD_END) {
+        if (!o->end_sent || ack.close_error)
+            remember_error(o, ack.close_error ? ack.close_error : EPROTO);
+        else
+            o->ended = 1;
+        return 1;
+    }
+    if (!o->head || !o->head->ipc_complete || o->ipc_inflight_bytes < o->head->length ||
+        ack.id != o->head->id || ack.written > o->head->length) {
+        remember_error(o, EPROTO);
+        o->protocol_failed = 1;
+        return -1;
+    }
+    uint64_t ack_now_ns = o->last_progress_ns;
+    if (o->last_ack_ns && ack_now_ns >= o->last_ack_ns &&
+        ack_now_ns - o->last_ack_ns > o->stats.max_parent_ack_gap_ns)
+        o->stats.max_parent_ack_gap_ns = ack_now_ns - o->last_ack_ns;
+    o->last_ack_ns = ack_now_ns;
+    add_counter(&o->stats.writer_write_ns_total, ack.writer_write_ns);
+    add_counter(&o->stats.writer_write_records, 1);
+    if (ack.writer_write_ns > o->stats.writer_write_ns_max)
+        o->stats.writer_write_ns_max = ack.writer_write_ns;
+    uint64_t pending_age_ns = ack_now_ns >= o->head->submitted_ns
+                                  ? ack_now_ns - o->head->submitted_ns
+                                  : 0;
+    if (pending_age_ns > o->stats.max_pending_age_ns)
+        o->stats.max_pending_age_ns = pending_age_ns;
+    o->stats.confirmed_bytes += ack.written;
+    if (ack.error) {
+        o->stats.rejected_bytes += o->head->length - ack.written;
+        remember_error(o, ack.error);
+    } else if (ack.written != o->head->length) {
+        o->stats.rejected_bytes += o->head->length - ack.written;
+        remember_error(o, EIO);
+    } else {
+        ++o->stats.completed_records;
+    }
+    remove_head(o);
+    o->stats.pending_bytes = o->stats.submitted_bytes - o->stats.confirmed_bytes -
+                             o->stats.rejected_bytes - o->stats.uncertain_bytes;
+    if (!o->stats.pending_bytes)
+        o->last_pending_poll_ns = 0;
+    return 1;
+}
+static int has_unsent_job(const ts_output *o) {
+    for (const struct ts_job *j = o->head; j; j = j->next)
+        if (!j->ipc_complete)
+            return 1;
+    return 0;
+}
+static int can_send_next_job(const ts_output *o) {
+    if (o->current)
+        return 1;
+    for (const struct ts_job *j = o->head; j; j = j->next) {
+        if (j->ipc_complete)
+            continue;
+        return !o->ipc_inflight_bytes ||
+               (o->ipc_inflight_bytes < TS_OUTPUT_IPC_WINDOW_BYTES &&
+                j->length <= TS_OUTPUT_IPC_WINDOW_BYTES - o->ipc_inflight_bytes);
+    }
+    return o->ending && !o->head && o->end_sent != 1;
+}
+static void check_stall(ts_output *o) {
+    if (!o->stats.pending_bytes || o->first_error)
+        return;
+    uint64_t now = mono_ns();
+    uint64_t elapsed = now - o->last_progress_ns;
+    unsigned warn = o->pipe_output ? o->pipe_stall_ms : o->warn_ms;
+    unsigned fail = o->pipe_output ? o->pipe_stall_ms : o->file_stall_ms;
+    if (elapsed >= (uint64_t)warn * 1000000ULL)
+        o->stats.warning = 1;
+    if (elapsed >= (uint64_t)fail * 1000000ULL) {
+        o->stats.stalled = 1;
+        remember_error(o, ETIMEDOUT);
+    }
+}
+int ts_output_open(const char *path, int stdout_fd, const ts_output_config *config,
+                   ts_output **out) {
+    if (!out)
+        return EINVAL;
+    *out = NULL;
+    int target = -1, owned = 0;
+    if (!path || !strcmp(path, "-")) {
+        if (stdout_fd < 0)
+            return EBADF;
+        target = dup(stdout_fd);
+        if (target < 0)
+            return errno;
+        owned = 1;
+    } else {
+        target = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_BINARY, 0666);
+        if (target < 0)
+            return errno;
+        owned = 1;
+    }
+    struct stat st;
+    int is_pipe = !fstat(target, &st) && (S_ISFIFO(st.st_mode) || S_ISSOCK(st.st_mode));
+    int pair[2];
+    if (socketpair(AF_UNIX, SOCK_STREAM, 0, pair)) {
+        int e = errno;
+        close(target);
+        return e;
+    }
+    /* A receive tick can submit a 64 KiB block. Keep enough IPC send space for
+       one such block so the nonblocking pump does not strand every frame on
+       repeated per-tick EAGAINs while the isolated writer drains it. */
+    int ipc_send_bytes = 256 * 1024;
+    if (setsockopt(pair[0], SOL_SOCKET, SO_SNDBUF, &ipc_send_bytes, sizeof(ipc_send_bytes))) {
+        int e = errno;
+        close(pair[0]);
+        close(pair[1]);
+        close(target);
+        return e;
+    }
+    if (set_nonblock(pair[0])) {
+        int e = errno;
+        close(pair[0]);
+        close(pair[1]);
+        close(target);
+        return e;
+    }
+    struct rlimit limit;
+    int max_fd = 65536;
+    if (!getrlimit(RLIMIT_NOFILE, &limit) && limit.rlim_cur != RLIM_INFINITY &&
+        limit.rlim_cur < (rlim_t)max_fd)
+        max_fd = (int)limit.rlim_cur;
+    size_t test_chunk = config ? config->test_write_chunk_bytes : 0;
+    uint64_t test_fail_after = config ? config->test_fail_after_bytes : 0;
+    int test_close_error = config ? config->test_close_error : 0;
+    int test_crash = config ? config->test_crash_after_receive : 0;
+    int test_stall_close_ack = config ? config->test_stall_close_ack : 0;
+    int test_stall_after_receive = config ? config->test_stall_after_receive : 0;
+    unsigned test_ack_batch_records = config ? config->test_ack_batch_records : 0;
+    unsigned test_write_delay_ms = config ? config->test_write_delay_ms : 0;
+    pid_t pid = fork();
+    if (pid < 0) {
+        int e = errno;
+        close(pair[0]);
+        close(pair[1]);
+        close(target);
+        return e;
+    }
+    if (pid == 0) {
+        close(pair[0]);
+        child_loop(pair[1], target, is_pipe, max_fd, test_chunk, test_fail_after, test_close_error,
+                   test_crash, test_stall_close_ack, test_stall_after_receive,
+                   test_ack_batch_records, test_write_delay_ms);
+        _exit(85);
+    }
+    close(pair[1]);
+    if (owned)
+        close(target);
+    ts_output *o = calloc(1, sizeof(*o));
+    if (!o) {
+        close(pair[0]);
+        kill(pid, SIGTERM);
+        (void)waitpid(pid, NULL, 0);
+        return ENOMEM;
+    }
+    o->child = pid;
+    o->socket_fd = pair[0];
+    o->pipe_output = is_pipe;
+    o->capacity =
+        config && config->capacity_bytes ? config->capacity_bytes : TS_OUTPUT_CAPACITY_BYTES;
+    if (!o->capacity || o->capacity > TS_OUTPUT_CAPACITY_BYTES)
+        o->capacity = TS_OUTPUT_CAPACITY_BYTES;
+    o->warn_ms =
+        config && config->file_warning_ms ? config->file_warning_ms : TS_OUTPUT_WARN_FILE_MS;
+    o->file_stall_ms =
+        config && config->file_stall_ms ? config->file_stall_ms : TS_OUTPUT_FAIL_FILE_MS;
+    o->pipe_stall_ms =
+        config && config->pipe_stall_ms ? config->pipe_stall_ms : TS_OUTPUT_FAIL_PIPE_MS;
+    o->drain_ms = config && config->drain_ms ? config->drain_ms : TS_OUTPUT_DRAIN_MS;
+    o->accepting = 1;
+    o->child_status = -1;
+    o->stats.child_status = -1;
+    o->stats.child_pid = (int64_t)pid;
+    o->test_write_chunk = test_chunk;
+    o->test_fail_after = test_fail_after;
+    o->test_close_error = test_close_error;
+    o->last_progress_ns = o->idle_since_ns = mono_ns();
+    *out = o;
+    return 0;
+}
+int ts_output_submit(ts_output *o, const void *data, size_t length, uint64_t *id) {
+    if (!o || (!data && length) || !length)
+        return EINVAL;
+    if (!o->accepting || o->first_error)
+        return o->first_error ? o->first_error : EPIPE;
+    if (length > o->capacity - o->queued) {
+        o->stats.submitted_bytes += length;
+        o->stats.rejected_bytes += length;
+        return EAGAIN;
+    }
+    struct ts_job *j = calloc(1, sizeof(*j));
+    if (!j) {
+        o->stats.submitted_bytes += length;
+        o->stats.rejected_bytes += length;
+        remember_error(o, ENOMEM);
+        return ENOMEM;
+    }
+    j->data = malloc(length);
+    if (!j->data) {
+        free(j);
+        o->stats.submitted_bytes += length;
+        o->stats.rejected_bytes += length;
+        remember_error(o, ENOMEM);
+        return ENOMEM;
+    }
+    int was_empty = o->stats.pending_bytes == 0;
+    j->submitted_ns = mono_ns();
+    memcpy(j->data, data, length);
+    j->length = length;
+    j->id = ++o->next_id;
+    if (o->tail)
+        o->tail->next = j;
+    else
+        o->head = j;
+    o->tail = j;
+    o->queued += length;
+    o->stats.submitted_bytes += length;
+    o->stats.pending_bytes += length;
+    if (o->stats.pending_bytes > o->stats.peak_pending_bytes)
+        o->stats.peak_pending_bytes = o->stats.pending_bytes;
+    if (id)
+        *id = j->id;
+    if (was_empty) {
+        o->last_progress_ns = j->submitted_ns;
+        o->last_pending_poll_ns = j->submitted_ns;
+    }
+    return 0;
+}
+int ts_output_poll(ts_output *o, unsigned timeout_ms) {
+    if (!o)
+        return EINVAL;
+    uint64_t poll_start_ns = mono_ns();
+    if (o->stats.pending_bytes) {
+        if (o->last_pending_poll_ns && poll_start_ns >= o->last_pending_poll_ns &&
+            poll_start_ns - o->last_pending_poll_ns > o->stats.max_parent_poll_gap_ns)
+            o->stats.max_parent_poll_gap_ns = poll_start_ns - o->last_pending_poll_ns;
+        o->last_pending_poll_ns = poll_start_ns;
+    } else
+        o->last_pending_poll_ns = 0;
+    uint64_t until = poll_start_ns + (uint64_t)timeout_ms * 1000000ULL;
+    /* A zero-time poll is used on the USB receive path. Drain all work that is
+       already runnable, but cap the work so a busy child cannot starve capture. */
+    const unsigned zero_poll_step_limit = 128;
+    const uint64_t zero_poll_time_limit_ns = 2000000ULL;
+    uint64_t zero_poll_start = mono_ns();
+    unsigned zero_poll_steps = 0;
+    do {
+        int send_progress = pump_send(o);
+        int ack_progress = pump_ack(o);
+        observe_child(o);
+        check_stall(o);
+        if (o->first_error)
+            return o->first_error;
+        if (timeout_ms == 0) {
+            if (!send_progress && !ack_progress)
+                return 0;
+            if (++zero_poll_steps >= zero_poll_step_limit ||
+                mono_ns() - zero_poll_start >= zero_poll_time_limit_ns) {
+                add_counter(&o->stats.zero_poll_budget_exhaustions, 1);
+                return 0;
+            }
+            continue;
+        }
+        if (ack_progress || mono_ns() >= until)
+            return 0;
+        int need_write = can_send_next_job(o) &&
+                         (o->current || has_unsent_job(o) || (o->ending && !o->head));
+        struct pollfd f = {o->socket_fd, (short)(POLLIN | (need_write ? POLLOUT : 0)), 0};
+        int wait = 10;
+        uint64_t remain = (until - mono_ns()) / 1000000ULL;
+        if (remain < (uint64_t)wait)
+            wait = (int)remain;
+        int rc;
+        do {
+            rc = poll(&f, 1, wait);
+        } while (rc < 0 && errno == EINTR);
+        if (rc < 0) {
+            remember_error(o, errno);
+            return o->first_error;
+        }
+    } while (mono_ns() < until || timeout_ms == 0);
+    return 0;
+}
+void ts_output_snapshot(ts_output *o, ts_output_stats *out) {
+    if (!out)
+        return;
+    memset(out, 0, sizeof(*out));
+    if (!o)
+        return;
+    observe_child(o);
+    o->stats.first_error = o->first_error;
+    o->stats.pending_bytes = o->stats.submitted_bytes - o->stats.confirmed_bytes -
+                             o->stats.rejected_bytes - o->stats.uncertain_bytes;
+    o->stats.last_progress_ns = o->last_progress_ns;
+    uint64_t now = mono_ns();
+    o->stats.oldest_pending_age_ns =
+        o->head && now >= o->head->submitted_ns ? now - o->head->submitted_ns : 0;
+    o->stats.finished = o->ended && o->reaped && !o->stats.pending_bytes && !o->first_error;
+    *out = o->stats;
+}
+static int wait_child(ts_output *o, unsigned timeout_ms) {
+    uint64_t end = mono_ns() + (uint64_t)timeout_ms * 1000000ULL;
+    for (;;) {
+        observe_child(o);
+        if (o->reaped)
+            return 0;
+        if (mono_ns() >= end)
+            return ETIMEDOUT;
+        struct timespec pause = {0, 10000000L};
+        nanosleep(&pause, NULL);
+    }
+}
+int ts_output_finish(ts_output *o, unsigned drain_ms) {
+    if (!o)
+        return EINVAL;
+    o->accepting = 0;
+    o->ending = 1;
+    if (!drain_ms)
+        drain_ms = o->drain_ms;
+    uint64_t end = mono_ns() + (uint64_t)drain_ms * 1000000ULL;
+    while (o->stats.pending_bytes && !o->first_error && mono_ns() < end)
+        (void)ts_output_poll(o, 10);
+    if (!o->stats.pending_bytes && !o->first_error) {
+        while (!o->ended && !o->first_error && mono_ns() < end)
+            (void)ts_output_poll(o, 10);
+        if (!o->first_error && o->ended) {
+            int rc =
+                wait_child(o, (unsigned)((end > mono_ns()) ? (end - mono_ns()) / 1000000ULL : 0));
+            if (rc)
+                remember_error(o, rc);
+        }
+        if (!o->first_error && (!o->ended || !o->reaped))
+            remember_error(o, ETIMEDOUT);
+    } else if (!o->first_error)
+        remember_error(o, ETIMEDOUT);
+    if (o->first_error)
+        (void)ts_output_abort(o,
+                              (unsigned)((end > mono_ns()) ? (end - mono_ns()) / 1000000ULL : 0));
+    return o->first_error;
+}
+int ts_output_abort(ts_output *o, unsigned deadline_ms) {
+    if (!o)
+        return EINVAL;
+    o->accepting = 0;
+    if (!o->first_error)
+        remember_error(o, ECANCELED);
+    (void)shutdown(o->socket_fd, SHUT_RDWR);
+    uint64_t end = mono_ns() + (uint64_t)deadline_ms * 1000000ULL;
+    if (!o->reaped)
+        (void)kill(o->child, SIGTERM);
+    while (!o->reaped && mono_ns() < end) {
+        observe_child(o);
+        if (!o->reaped) {
+            struct timespec pause = {0, 10000000L};
+            nanosleep(&pause, NULL);
+        }
+    }
+    if (!o->reaped) {
+        (void)kill(o->child, SIGKILL);
+        observe_child(o);
+    }
+    if (o->reaped)
+        classify_unresolved(o);
+    return o->reaped ? 0 : ETIMEDOUT;
+}
+int ts_output_destroy(ts_output *o) {
+    if (!o)
+        return 0;
+    if (!o->reaped)
+        (void)ts_output_abort(o, 250);
+    if (!o->reaped)
+        return ETIMEDOUT;
+    close(o->socket_fd);
+    struct ts_job *j = o->head;
+    while (j) {
+        struct ts_job *next = j->next;
+        free(j->data);
+        free(j);
+        j = next;
+    }
+    free(o);
+    return 0;
+}
+#endif
diff --git a/tests/test_cli_compat.sh b/tests/test_cli_compat.sh
new file mode 100755
index 0000000..e6de617
--- /dev/null
+++ b/tests/test_cli_compat.sh
@@ -0,0 +1,149 @@
+#!/bin/sh
+set -eu
+
+# Usage: tests/test_cli_compat.sh [HEAD-pix-ts] [working-pix-ts]
+baseline=${1:-}
+candidate=${2:-./pix-ts}
+python=${PYTHON:-python3}
+tmp=$(mktemp -d "${TMPDIR:-/tmp}/pix-cli-compat.XXXXXX")
+trap 'for name in output.ts synthetic.ts candidate.out candidate.err baseline.out baseline.err; do unlink "$tmp/$name" 2>/dev/null || true; done; rmdir "$tmp" 2>/dev/null || true' EXIT HUP INT TERM
+
+status_of() {
+    binary=$1
+    shift
+    set +e
+    "$binary" "$@" >/dev/null 2>&1
+    status=$?
+    set -e
+    printf '%s' "$status"
+}
+
+help_line=$("$candidate" --help | sed -n '1p' | tr -d '\r')
+case "$help_line" in
+    "pix-ts "*" — PIX-DT181-PU0 libusb TS receiver") ;;
+    *) echo "Legacy help first line changed: $help_line" >&2; exit 1 ;;
+esac
+candidate_version=$("$candidate" --version | tr -d '\r')
+case "$candidate_version" in "pix-ts "*) ;; *) echo "Unexpected version output: $candidate_version" >&2; exit 1 ;; esac
+if [ -n "$baseline" ]; then
+    baseline_help_line=$("$baseline" --help | sed -n '1p' | tr -d '\r')
+    [ "$help_line" = "$baseline_help_line" ] || { echo "Help first line differs from HEAD" >&2; exit 1; }
+    baseline_version=$("$baseline" --version | tr -d '\r')
+    [ "$candidate_version" = "$baseline_version" ] || { echo "Version differs from HEAD" >&2; exit 1; }
+fi
+
+# These invalid combinations are parser-only and must not enumerate USB.
+for args in \
+    '--channel -1' \
+    '--channel 27junk' \
+    '--channel 0' \
+    '--system bs --channel 2' \
+    '--system cs --channel 23' \
+    '--channel 27 --time 0' \
+    '--channel 27 --tsid 5' \
+    '--model unknown' \
+    '--model dt295 --control' \
+    '--model dt295 -c BS01_0' \
+    '--model dt295 -c T27 --freq 557142857' \
+    '--fd 1 --list' \
+    '--fd 1 --device 2' \
+    '--decode missing' \
+    '--replay-chunk-bytes 1' \
+    '--list --diagnostic ignored'; do
+    # Word splitting is deliberate: each fixture is a fixed argv list.
+    # shellcheck disable=SC2086
+    actual=$(status_of "$candidate" $args)
+    [ "$actual" -eq 2 ] || { echo "Expected exit 2, got $actual: $args" >&2; exit 1; }
+    if [ -n "$baseline" ]; then
+        # shellcheck disable=SC2086
+        old=$(status_of "$baseline" $args)
+        [ "$actual" = "$old" ] || { echo "Exit mismatch for $args: HEAD=$old candidate=$actual" >&2; exit 1; }
+    fi
+done
+
+# A valid DT181 capture request with missing private assets stops at the legacy
+# asset failure (10), before USB discovery or device access.
+actual=$(status_of "$candidate" --channel T27 --assets "$tmp/missing-assets")
+[ "$actual" -eq 10 ] || { echo "Expected DT181 asset exit 10, got $actual" >&2; exit 1; }
+if [ -n "$baseline" ]; then
+    old=$(status_of "$baseline" --channel T27 --assets "$tmp/missing-assets")
+    [ "$old" = "$actual" ] || { echo "DT181 default-model exit changed: HEAD=$old candidate=$actual" >&2; exit 1; }
+fi
+actual=$(status_of "$candidate" --model dt181 --channel T27 --assets "$tmp/missing-assets")
+[ "$actual" -eq 10 ] || { echo "Explicit dt181 did not preserve legacy path: $actual" >&2; exit 1; }
+
+# The documented output policy truncates an existing file before asset loading.
+test_output_policy() {
+    binary=$1
+    path="$tmp/output.ts"
+    printf 'must be truncated\n' > "$path"
+    actual=$(status_of "$binary" --channel T27 --assets "$tmp/missing-assets" --output "$path")
+    [ "$actual" -eq 10 ] || { echo "Expected asset failure after output open, got $actual" >&2; exit 1; }
+    [ ! -s "$path" ] || { echo "Existing output was not truncated" >&2; exit 1; }
+}
+test_output_policy "$candidate"
+if [ -n "$baseline" ]; then test_output_policy "$baseline"; fi
+
+# Control-mode quit exits without opening a receiver.
+test_control_quit() {
+    binary=$1
+    set +e
+    printf 'quit\n' | "$binary" --control >/dev/null 2>&1
+    actual=$?
+    set -e
+    [ "$actual" -eq 0 ] || { echo "Control quit returned $actual" >&2; exit 1; }
+}
+test_control_quit "$candidate"
+if [ -n "$baseline" ]; then test_control_quit "$baseline"; fi
+
+# While control mode is idle it polls stdin without USB; both stop signals
+# should take the documented clean-interrupt path and return zero.
+test_control_signal() {
+    "$python" - "$1" <<'PY'
+import os, signal, subprocess, sys, time
+if os.name == 'nt':
+    print('Skipping idle-control POSIX signal smoke test on Windows')
+    raise SystemExit(0)
+p = subprocess.Popen([sys.argv[1], '--control'], stdin=subprocess.PIPE,
+                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+time.sleep(0.05)
+p.send_signal(signal.SIGTERM)
+status = p.wait(timeout=3)
+if status != 0:
+    raise SystemExit('SIGTERM returned %d, expected 0' % status)
+p = subprocess.Popen([sys.argv[1], '--control'], stdin=subprocess.PIPE,
+                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+time.sleep(0.05)
+p.send_signal(signal.SIGINT)
+status = p.wait(timeout=3)
+if status != 0:
+    raise SystemExit('SIGINT returned %d, expected 0' % status)
+PY
+}
+test_control_signal "$candidate"
+if [ -n "$baseline" ]; then test_control_signal "$baseline"; fi
+
+# A synthetic null-packet fixture exercises the offline DT181 inspector without
+# opening USB. Its return code and statistics must remain byte-for-byte stable.
+"$python" - "$tmp/synthetic.ts" <<'PY'
+import sys
+p = bytearray([0xff] * 188)
+p[0:4] = bytes((0x47, 0x1f, 0xff, 0x10))
+open(sys.argv[1], 'wb').write(p)
+PY
+set +e
+"$candidate" --inspect "$tmp/synthetic.ts" >"$tmp/candidate.out" 2>"$tmp/candidate.err"
+candidate_status=$?
+set -e
+[ "$candidate_status" -eq 8 ] || { echo "Synthetic offline inspector returned $candidate_status, expected legacy 8" >&2; exit 1; }
+if [ -n "$baseline" ]; then
+    set +e
+    "$baseline" --inspect "$tmp/synthetic.ts" >"$tmp/baseline.out" 2>"$tmp/baseline.err"
+    baseline_status=$?
+    set -e
+    [ "$candidate_status" = "$baseline_status" ] || { echo "Offline inspector exit changed: HEAD=$baseline_status candidate=$candidate_status" >&2; exit 1; }
+    cmp -s "$tmp/candidate.out" "$tmp/baseline.out" || { echo "Offline stdout changed" >&2; exit 1; }
+    cmp -s "$tmp/candidate.err" "$tmp/baseline.err" || { echo "Offline DT181 statistics changed" >&2; exit 1; }
+fi
+
+echo "CLI compatibility tests passed${baseline:+ against HEAD baseline}"
diff --git a/tests/test_dt295.c b/tests/test_dt295.c
new file mode 100644
index 0000000..6ebb54e
--- /dev/null
+++ b/tests/test_dt295.c
@@ -0,0 +1,58 @@
+#include "dt295.h"
+#include "dt295_crypto.h"
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+int random_bytes(void *p, size_t n) {
+    memset(p, 0, n);
+    return 0;
+}
+
+static void from_hex(const char *s, uint8_t *out, size_t n) {
+    for (size_t i = 0; i < n; i++) {
+        unsigned x = 0;
+        assert(sscanf(s + 2 * i, "%2x", &x) == 1);
+        out[i] = (uint8_t)x;
+    }
+}
+
+int main(void) {
+    uint8_t digest[32], want[32];
+    dt295_sha256((const uint8_t *)"abc", 3, digest);
+    from_hex("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", want, 32);
+    assert(memcmp(digest, want, 32) == 0);
+
+    uint8_t key[16], mac[16], want_mac[16];
+    from_hex("2b7e151628aed2a6abf7158809cf4f3c", key, 16);
+    dt295_cmac(key, NULL, 0, mac);
+    from_hex("bb1d6929e95937287fa37d129b756746", want_mac, 16);
+    assert(memcmp(mac, want_mac, 16) == 0);
+
+    uint16_t divider = 0;
+    assert(dt295_terrestrial_rf_divider(13, &divider) == 0 && divider == 30281);
+    assert(dt295_terrestrial_rf_divider(27, &divider) == 0 && divider == 35657);
+    assert(dt295_terrestrial_rf_divider(62, &divider) == 0 && divider == 49097);
+    assert(dt295_terrestrial_rf_divider(12, &divider) < 0);
+
+    uint8_t iv[16] = {0}, packet[188] = {0x47, 0, 0, 0x10}, original[188];
+    assert(dt295_packet_crypto(key, iv, packet) == 0);
+    packet[3] = 0x90;
+    memcpy(original, packet, sizeof(packet));
+    assert(dt295_packet_crypto(key, iv, packet) == -2);
+    assert(memcmp(packet, original, sizeof(packet)) == 0);
+    packet[3] = 0x30;
+    packet[4] = 184;
+    memcpy(original, packet, sizeof(packet));
+    assert(dt295_packet_crypto(key, iv, packet) == -1);
+    assert(memcmp(packet, original, sizeof(packet)) == 0);
+    packet[3] = 0x10;
+    packet[4] = 0;
+    assert(dt295_packet_crypto(key, iv, packet) == 0);
+    packet[0] = 0;
+    memcpy(original, packet, sizeof(packet));
+    assert(dt295_packet_crypto(key, iv, packet) == -1);
+    assert(memcmp(packet, original, sizeof(packet)) == 0);
+    return 0;
+}
diff --git a/tests/test_dt295_assets.py b/tests/test_dt295_assets.py
new file mode 100644
index 0000000..8a9798a
--- /dev/null
+++ b/tests/test_dt295_assets.py
@@ -0,0 +1,118 @@
+"""Synthetic profile normalization tests; never loads private files."""
+import importlib.util
+import json
+from pathlib import Path
+import struct
+import tempfile
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location(
+    "prepare_dt295_assets", ROOT / "tools" / "prepare-dt295-assets.py")
+ASSETS = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(ASSETS)
+
+
+def field(name, address, value=0, shift=0, width=1):
+    return {"name": name, "address": address, "shift": shift,
+            "width": width, "value": value}
+
+
+class TestDT295Assets(unittest.TestCase):
+    def parse(self, profile):
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / "synthetic-profile.json"
+            path.write_text(json.dumps(profile), encoding="utf-8")
+            return ASSETS.parse_profile(path)
+
+    def profile(self):
+        return {
+            "schema": 1,
+            "target": 0,
+            "ts_key_request_words": [1, 2, 3],
+            "fields": [
+                field("INIT_S_AUTO_PID_MODE", 0x1000, 1),
+                field("INIT_S_PAYLOAD_UNIT_START_DISABLE_MODE", 0x1002, 0),
+                field("INIT_S_PROGRAM_NUMBER", 0x1018, 0x1234, width=16),
+                field("INIT_S_V_STREAM_TYPE", 0x101C, 2),
+                field("INIT_S_A_STREAM_TYPE", 0x101C, 4),
+                field("INIT_S_V_ECM", 0x10A2, 5, width=7),
+                field("INIT_S_A_ECM", 0x10A2, 6, shift=8, width=7),
+                field("INIT_S_PID_SLOT_63", 0x10E0, 63, width=7),
+                field("INIT_S_ECM_SLOT_6", 0x10A8, 6, shift=8, width=7),
+                field("INIT_S_OTHER_BASELINE", 0x1100, 1),
+            ],
+        }
+
+    def test_route_fields_are_removed_and_required_modes_are_normalized(self):
+        fields, key_request = self.parse(self.profile())
+        records = [struct.unpack_from("<HBBHH", fields, offset)
+                   for offset in range(0, len(fields), 8)]
+        self.assertEqual(key_request, struct.pack(">3I", 1, 2, 3))
+        self.assertEqual(records, [
+            (0x1000, 0, 1, 0, 0),
+            (0x1002, 0, 1, 1, 0),
+            (0x1100, 0, 1, 1, 0),
+        ])
+
+    def test_missing_or_duplicate_normalized_fields_are_rejected(self):
+        profile = self.profile()
+        profile["fields"] = [row for row in profile["fields"]
+                             if row["name"] != "INIT_S_AUTO_PID_MODE"]
+        with self.assertRaisesRegex(ValueError, "missing required normalized field"):
+            self.parse(profile)
+
+        profile = self.profile()
+        profile["fields"].append(field("INIT_S_AUTO_PID_MODE", 0x1004, 1))
+        with self.assertRaisesRegex(ValueError, "duplicate INIT_S_AUTO_PID_MODE"):
+            self.parse(profile)
+
+    def test_bad_profile_shape_and_bit_ranges_are_rejected(self):
+        profile = self.profile()
+        profile["fields"][0] = "malformed row"
+        with self.assertRaisesRegex(ValueError, "fields must be objects"):
+            self.parse(profile)
+
+        profile = self.profile()
+        profile["fields"][-1]["width"] = 17
+        with self.assertRaisesRegex(ValueError, "bit range"):
+            self.parse(profile)
+
+        profile = self.profile()
+        profile["target"] = 1
+        with self.assertRaisesRegex(ValueError, "target 0"):
+            self.parse(profile)
+
+    def test_boolean_schema_and_target_are_rejected(self):
+        profile = self.profile()
+        profile["schema"] = True
+        with self.assertRaisesRegex(ValueError, "schema 1 and target 0"):
+            self.parse(profile)
+
+    def test_bundle_keeps_ts_iv_distinct_from_control_session_material(self):
+        fields, key_request = self.parse(self.profile())
+        material = bytes(ASSETS.MAT_END - ASSETS.MAT_BASE)
+        control_iv = material[0x85218 - ASSETS.MAT_BASE:0x85218 - ASSETS.MAT_BASE + 16]
+        ts_iv = bytes(range(16))
+        self.assertNotEqual(ts_iv, control_iv)
+        bundle = ASSETS.build_bundle(b"idle", b"trc", material, fields, key_request, ts_iv)
+        lengths = [struct.unpack_from("<I", bundle, 8 + i * 36)[0] for i in range(6)]
+        sections = []
+        offset = 8 + 6 * 36
+        for length in lengths:
+            sections.append(bundle[offset:offset + length])
+            offset += length
+        self.assertEqual(sections[2], material)
+        self.assertEqual(sections[5], ts_iv)
+        self.assertNotEqual(sections[5], sections[2][0x85218 - ASSETS.MAT_BASE:
+                                                     0x85218 - ASSETS.MAT_BASE + 16])
+
+        profile = self.profile()
+        profile["target"] = False
+        with self.assertRaisesRegex(ValueError, "schema 1 and target 0"):
+            self.parse(profile)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_dt295_capture.c b/tests/test_dt295_capture.c
new file mode 100644
index 0000000..78c9d04
--- /dev/null
+++ b/tests/test_dt295_capture.c
@@ -0,0 +1,772 @@
+#ifdef _WIN32
+#include <stdio.h>
+int main(void) {
+    puts("DT295 capture orchestration: skipped (POSIX implementation only)");
+    return 0;
+}
+#else
+/* SPDX-License-Identifier: MIT */
+/* Exercise the real capture orchestrator and routing watcher with synthetic
+ * broadcast tables and injected protocol/USB/output. No libusb discovery. */
+#define DT295_CAPTURE_TESTING
+#define now_ms capture_test_now
+#include "../src/dt295_capture.c"
+#undef now_ms
+#include <assert.h>
+
+struct dt295_assets {
+    int valid;
+};
+struct dt295 {
+    int state, session, starts;
+};
+struct usb_backend {
+    int unused;
+};
+struct dt295_stream {
+    int generation;
+    uint64_t sequence;
+    uint64_t delivered;
+    size_t offset;
+    size_t fixture_length;
+    unsigned split_boundary;
+    uint8_t fixture[188 * 16];
+};
+struct ts_output {
+    ts_output_stats stats;
+    int diagnostic;
+};
