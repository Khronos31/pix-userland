#!/usr/bin/env bash
set -euo pipefail

arguments=("$@")
fd=
if ((${#arguments[@]} > 0)); then
    fd=${arguments[$((${#arguments[@]} - 1))]}
fi

run_without_usb_fd()
{
    local descriptor=$fd
    if [[ $descriptor =~ ^[0-9]+$ ]]; then exec {descriptor}>&-; fi
    exec "$@"
}

show_help()
{
    printf '%s\n' \
        "usage: termux-usb -r -e \"$0 [pix-ts options...]\" USB_DEVICE" \
        '       pix-termux --help' \
        '       pix-termux --version'
}

root=$(CDPATH= cd -- "$(run_without_usb_fd dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
metadata_arguments=()
for ((index = 0; index < ${#arguments[@]}; ++index)); do
    argument=${arguments[index]}
    if [[ $argument == --firmware ]]; then
        if ((index + 1 < ${#arguments[@]})); then
            value=${arguments[index + 1]}
            if [[ $value == -h || $value == --help || $value == --version ]]; then
                metadata_arguments+=("$value")
            fi
            ((index += 1))
        fi
        continue
    fi
    metadata_arguments+=("$argument")
done

validation_argument=--pix-termux-validation
while :; do
    collision=false
    for argument in "${metadata_arguments[@]}"; do
        if [[ $argument == "$validation_argument" ||
              $argument == "$validation_argument-2" ]]; then
            collision=true
            break
        fi
    done
    [[ $collision == false ]] && break
    validation_argument+="-"
done
if metadata_output=$(run_without_usb_fd "$root/pix-ts" "${metadata_arguments[@]}" \
    "$validation_argument" "$validation_argument-2" 2>&1); then
    if [[ $metadata_output == "pix-ts "* ]]; then
        printf 'pix-termux %s\n' "${metadata_output#pix-ts }"
    else
        show_help
    fi
    exit 0
else
    metadata_status=$?
fi

if ((metadata_status != 2)); then
    printf '%s\n' "$metadata_output" >&2
    exit "$metadata_status"
fi

if (($# < 2)); then
    show_help >&2
    exit 2
fi

if [[ ! $fd =~ ^[0-9]+$ ]] || ((10#$fd < 3 || 10#$fd > 2147483647)); then
    echo 'pix-termux: expected the USB file descriptor appended by termux-usb' >&2
    exit 2
fi
fd=$((10#$fd))
raw_client_arguments=("${arguments[@]:0:$((${#arguments[@]} - 1))}")
client_arguments=()
firmware_path=
for ((index = 0; index < ${#raw_client_arguments[@]}; ++index)); do
    argument=${raw_client_arguments[index]}
    if [[ $argument == -o || $argument == --output ]]; then
        client_arguments+=("$argument")
        if ((index + 1 < ${#raw_client_arguments[@]})); then
            client_arguments+=("${raw_client_arguments[++index]}")
        fi
        continue
    fi
    if [[ $argument == -F || $argument == -V ]]; then
        echo "pix-termux: unknown argument: $argument" >&2
        exit 2
    fi
    if [[ $argument == --firmware ]]; then
        if [[ -n $firmware_path || $((index + 1)) -ge ${#raw_client_arguments[@]} ]]; then
            echo 'pix-termux: provide exactly one --firmware FILE argument' >&2
            exit 2
        fi
        firmware_path=${raw_client_arguments[++index]}
        if [[ -z $firmware_path ]]; then
            echo 'pix-termux: firmware path must not be empty' >&2
            exit 2
        fi
        continue
    fi
    client_arguments+=("$argument")
done
if [[ -z $firmware_path ]]; then
    echo 'pix-termux: --firmware FILE is required' >&2
    exit 2
fi

for argument in "${client_arguments[@]}"; do
    if [[ $argument == --instance || $argument == --runtime-dir || $argument == --group ]]; then
        echo 'pix-termux: instance and runtime options are managed by the launcher' >&2
        exit 2
    fi
done

validation_runtime_directory=${TMPDIR:-${PREFIX:-/data/data/com.termux/files/usr}/tmp}/pix-termux-validation-$BASHPID-$RANDOM
while [[ -e $validation_runtime_directory || -L $validation_runtime_directory ]]; do
    validation_runtime_directory=${TMPDIR:-${PREFIX:-/data/data/com.termux/files/usr}/tmp}/pix-termux-validation-$BASHPID-$RANDOM
done
validation_client_arguments=()
have_output=false
for ((index = 0; index < ${#client_arguments[@]}; ++index)); do
    argument=${client_arguments[index]}
    if [[ $argument == -o || $argument == --output ]]; then
        have_output=true
        validation_client_arguments+=("$argument")
        if ((index + 1 < ${#client_arguments[@]})); then
            validation_client_arguments+=(/dev/null)
            ((index += 1))
        fi
    else
        validation_client_arguments+=("$argument")
    fi
done
if [[ $have_output == false ]]; then
    validation_client_arguments+=(--output /dev/null)
fi
validation_status=0
if validation_output=$(run_without_usb_fd "$root/pix-ts" \
    --runtime-dir "$validation_runtime_directory" --instance pix-fd \
    "${validation_client_arguments[@]}" 2>&1); then
    printf '%s\n' "$validation_output" >&2
    exit 70
else
    validation_status=$?
fi
if ((validation_status == 2)); then
    printf '%s\n' "$validation_output" >&2
    exit 2
fi

tmp_root=${TMPDIR:-${PREFIX:-/data/data/com.termux/files/usr}/tmp}
runtime_directory=$(run_without_usb_fd mktemp -d "$tmp_root/pix-termux.XXXXXX")
run_without_usb_fd chmod 700 "$runtime_directory" &
helper_pid=$!
wait "$helper_pid"
daemon_pid=
client_pid=
stop_signal=
daemon_status=0
show_daemon_log=0

cleanup()
{
    result=$?
    trap - EXIT
    trap '' INT TERM
    local cleanup_status=0
    if [[ -n $daemon_pid ]]; then
        if [[ -n $client_pid ]]; then
            if kill -TERM "$client_pid" 2>/dev/null; then :; fi
            wait_for_client
            if ((result == 0)); then result=$client_status; fi
        fi
        if kill -0 "$daemon_pid" 2>/dev/null; then
            if ! kill -TERM "$daemon_pid" 2>/dev/null; then
                :
            fi
        fi
        if wait "$daemon_pid"; then
            daemon_status=0
        else
            daemon_status=$?
        fi
        daemon_pid=
        if ((daemon_status != 0)); then show_daemon_log=1; fi
        if ((result == 0 && daemon_status != 0)); then result=$daemon_status; fi
    fi
    if ((show_daemon_log != 0)) && [[ -f $runtime_directory/pixd.log ]]; then
        run_without_usb_fd cat "$runtime_directory/pixd.log" >&2 &
        helper_pid=$!
        if wait "$helper_pid"; then
            :
        else
            cleanup_status=1
        fi
    fi
    local descriptor=$fd
    if ! exec {descriptor}>&- 2>/dev/null; then cleanup_status=1; fi
    if ! rm -rf -- "$runtime_directory"; then cleanup_status=1; fi
    if ((result == 0 && cleanup_status != 0)); then result=1; fi
    exit "$result"
}

handle_signal()
{
    local signal_name=$1
    if [[ -z $stop_signal ]]; then stop_signal=$signal_name; fi
    if [[ -n $client_pid ]]; then
        if ! kill -s "$signal_name" "$client_pid" 2>/dev/null; then :; fi
    fi
}

wait_for_client()
{
    while :; do
        if wait "$client_pid"; then
            client_status=0
        else
            client_status=$?
        fi
        if ((client_status > 128)) && kill -0 "$client_pid" 2>/dev/null; then
            continue
        fi
        client_pid=
        return 0
    done
}

trap cleanup EXIT
trap 'handle_signal INT' INT
trap 'handle_signal TERM' TERM

cd "$root"
"$root/pixd" --fd "$fd" --firmware "$firmware_path" --runtime-dir "$runtime_directory" \
    --instance pix-fd >"$runtime_directory/pixd.log" 2>&1 &
daemon_pid=$!

ready=false
for ((attempt = 0; attempt < 100; ++attempt)); do
    if [[ -n $stop_signal ]]; then exit 0; fi
    run_without_usb_fd "$root/pixctl" --runtime-dir "$runtime_directory" \
        --instance pix-fd status >/dev/null 2>&1 &
    helper_pid=$!
    if wait "$helper_pid"; then
        ready=true
        break
    fi
    if ! kill -0 "$daemon_pid" 2>/dev/null; then
        show_daemon_log=1
        exit 7
    fi
    run_without_usb_fd sleep 0.1 &
    helper_pid=$!
    wait "$helper_pid"
done
if [[ $ready != true ]]; then
    show_daemon_log=1
    echo 'pix-termux: pixd did not become ready' >&2
    exit 7
fi

if [[ -n $stop_signal ]]; then exit 0; fi
run_without_usb_fd "$root/pix-ts" --runtime-dir "$runtime_directory" \
    --instance pix-fd "${client_arguments[@]}" &
client_pid=$!
if [[ -n $stop_signal ]]; then
    if ! kill -s "$stop_signal" "$client_pid" 2>/dev/null; then :; fi
fi
wait_for_client
exit "$client_status"
